{
  "http": true,
  "prompt_image": true,
  "by_prompt": {
    "pose l'image collée": {
      "mcp": [
        { "tool": "apply", "args": { "label": "Image collée", "ops": [
          { "op": "set_param", "target": { "slide": "s-libre", "element": "e-image" }, "param": "asset",
            "value": "sha256:c414cd0e204de974f73753c7e28d7638e7b3691bb8b1a2bab6b25bb7fed7ce77" }
        ] } }
      ],
      "chunks": ["Image posée."]
    },
    "modifie le graphique des ventes": {
      "mcp": [
        { "tool": "apply", "args": { "label": "Ventes de janvier", "ops": [
          { "op": "set_data", "target": { "slide": "s-ventes", "element": "e-ventes" }, "param": "option",
            "change": { "op": "set_cell", "row": 1, "col": 1, "value": 9 } }
        ] } },
        { "tool": "report", "args": { "title": "Graphique mis à jour", "facts": ["2 séries"] } }
      ],
      "chunks": ["Graphique modifié."]
    },
    "ouvre l'atelier": { "mcp": [{ "tool": "open_pack", "args": {} }], "chunks": ["Atelier ouvert."] },
    "ouvre le thème": { "mcp": [{ "tool": "open_theme", "args": { "theme": "papier" } }], "chunks": ["Thème ouvert."] },
    "ouvre le thème avec une demande": {
      "mcp": [{ "tool": "open_theme", "args": { "theme": "papier", "request": "Passe les titres en bleu." } }],
      "chunks": ["Thème ouvert."]
    },
    "portée slides": { "chunks": ["Réponse des slides."] },
    "propose les thèmes": {
      "mcp": [
        { "tool": "show_themes", "args": { "slide": "s-libre" } },
        { "tool": "report", "args": { "title": "Thèmes proposés", "facts": ["choisissez-en un au dock"] } }
      ],
      "chunks": ["Voici les thèmes."]
    },
    "suite des thèmes": { "chunks": ["Thème noté."] },
    "lis le reçu": {
      "mcp": [{ "tool": "report", "args": { "title": "Reçu lu à voix haute", "facts": ["Diapo deux changée"] } }],
      "chunks": ["Reçu montré."]
    },
    "lis le reçu présenté": {
      "mcp": [{ "tool": "report", "args": { "title": "Reçu pendant la présentation", "facts": ["Diapo trois"] } }],
      "chunks": ["Reçu montré."]
    },
    "lis le reçu témoin": {
      "mcp": [{ "tool": "report", "args": { "title": "Reçu témoin", "facts": ["Après la présentation"] } }],
      "chunks": ["Reçu montré."]
    },
    "lis plus vite": { "mcp": [{ "tool": "set_speech", "args": { "rate": 1.5 } }], "chunks": ["Lecture plus rapide."] },
    "lis normalement": { "mcp": [{ "tool": "set_speech", "args": { "rate": 1 } }], "chunks": ["Lecture normale."] },
    "pose la base de coût": { "chunks": ["Base posée."], "usage": [12, 10, 2], "cost": { "amount": 0.1, "currency": "USD" } },
    "compte les tokens": { "chunks": ["Compté."], "usage": [5432, 4321, 1111], "cost": { "amount": 0.4321, "currency": "USD" } },
    "combien a coûté ce deck": { "mcp": [{ "tool": "show_usage", "args": { "by": "tab" } }], "chunks": ["Voici l'usage."] },
    "portée atelier": { "chunks": ["Réponse de l'atelier."] },
    "présente en fenêtre": { "mcp": [{ "tool": "present", "args": { "mode": "window" } }], "chunks": ["Présentation lancée."] },
    "passe en sombre": { "mcp": [{ "tool": "set_interface", "args": { "scheme": "dark" } }], "chunks": ["Schéma sombre."] },
    "remets le schéma du système": { "mcp": [{ "tool": "set_interface", "args": { "scheme": "system" } }], "chunks": ["Schéma du système."] },
    "affiche les repères": { "mcp": [{ "tool": "set_interface", "args": { "guides": true } }], "chunks": ["Repères affichés."] },
    "masque les repères": { "mcp": [{ "tool": "set_interface", "args": { "guides": false } }], "chunks": ["Repères masqués."] },
    "replie les diapositives et ouvre le code": {
      "mcp": [{ "tool": "set_interface", "args": { "folded": { "slides": true }, "code": true } }],
      "chunks": ["Diapositives repliées."]
    },
    "déplie les diapositives et ferme le code": {
      "mcp": [{ "tool": "set_interface", "args": { "folded": { "slides": false }, "code": false } }],
      "chunks": ["Diapositives dépliées."]
    },
    "ajoute une diapositive titre": { "chunks": ["Diapositive notée."] },
    "attends mon signal": { "wait_cancel": true, "chunks": [] },
    "bonjour tout le monde": { "chunks": ["Bonjour."] },
    "retitre le deck pour annuler": {
      "mcp": [{ "tool": "apply", "args": { "ops": [{ "op": "set_deck_param", "key": "title", "value": "Titre à annuler" }] } }],
      "chunks": ["Titre changé."]
    },
    "annule le dernier changement": { "mcp": [{ "tool": "undo", "args": {} }], "chunks": ["Changement annulé."] },
    "rétablis le changement": { "mcp": [{ "tool": "redo", "args": { "steps": 1 } }], "chunks": ["Changement rétabli."] },
    "montre la slide libre": { "mcp": [{ "tool": "focus", "args": { "slide": "s-libre" } }], "chunks": ["Slide montrée."] },
    "désélectionne tout": { "mcp": [{ "tool": "focus", "args": {} }], "chunks": ["Sélection levée."] },
    "annule un tour inconnu": { "mcp": [{ "tool": "undo_turn", "args": { "turn": 999999 } }], "chunks": ["Tour non annulé."] },
    "mets à jour un pack inconnu": { "mcp": [{ "tool": "pack_update", "args": { "pack": "inconnu", "action": "use_mine" } }], "chunks": ["Pack non mis à jour."] },
    "rattache l'agent": { "mcp": [{ "tool": "window", "args": { "action": "attach_agent" } }], "chunks": ["Agent non rattaché."] },
    "cherche les mises à jour": { "mcp": [{ "tool": "update", "args": { "action": "check" } }], "chunks": ["Mises à jour cherchées."] },
    "après le rechargement": { "chunks": ["Toujours à l'écoute."] },
    "ouvre l'aide sur la dictée": { "mcp": [{ "tool": "help", "args": { "query": "dictée" } }], "chunks": ["Aide ouverte."] },
    "quitte l'application": { "mcp": [{ "tool": "quit", "args": {} }], "chunks": ["Je ne peux pas quitter ici."] },
    "repars de zéro": { "mcp": [{ "tool": "new_conversation", "args": {} }], "chunks": ["On repart de zéro."] },
    "importe la présentation": {
      "mcp": [{ "tool": "import", "args": { "path": "${OKU_SLIDES_PATHS__DECKS}/e2e-390/e2e-390.pptx", "mode": "hifi" } }],
      "chunks": ["Présentation importée."]
    },
    "liste les onglets": {
      "mcp": [{ "tool": "tabs", "args": {} }],
      "chunks": ["Onglets listés."]
    },
    "fusionne la copie": {
      "mcp": [{ "tool": "merge", "args": { "path": "${OKU_SLIDES_PATHS__DECKS}/e2e-350/copie.oku-slides.pdf" } }],
      "chunks": ["Copie fusionnée."]
    },
    "Peaufiner la présentation importée": {
      "tool_calls": [{ "id": "i1", "title": "Lire le rapport d'import" }, { "id": "i2", "title": "Comparer la slide 7" }],
      "mcp": [
        { "tool": "import_report", "args": {} },
        { "tool": "import_diff", "args": { "slide": "s7" } },
        { "tool": "report", "args": { "title": "Import peaufiné", "facts": ["slide 7 comparée à l'original"], "slide": "s7" } }
      ],
      "chunks": ["Import comparé."]
    }
  },
  "by_prefix": {
    "active l'onglet ": {
      "mcp": [{ "tool": "tab", "args": { "action": "activate", "tab": "${ARG}" } }],
      "chunks": ["Onglet affiché."]
    },
    "ferme l'onglet ": {
      "mcp": [{ "tool": "tab", "args": { "action": "close", "tab": "${ARG}" } }],
      "chunks": ["Onglet fermé."]
    }
  },
  "turns": [
    {
      "plan": [{ "content": "Lire la slide", "status": "completed" }, { "content": "Proposer des reformulations", "status": "in_progress" }],
      "tool_calls": [{ "id": "t1", "title": "Lire la slide" }],
      "mcp": [
        { "tool": "focus", "args": { "slide": "s-libre" } },
        { "tool": "ask_rewrite", "args": { "slide": "s-libre", "owner": "e-texte", "proposals": ["Un bloc bien placé", "Un bloc libre"] } }
      ],
      "chunks": ["Texte reformulé."]
    },
    {
      "tool_calls": [
        { "id": "t2", "title": "Lire la slide" },
        { "id": "t3", "title": "Préparer les variantes", "input": { "slide": "s-libre", "variants": 2 }, "output": [{ "type": "text", "text": "2 variantes prêtes" }] }
      ],
      "mcp": [
        { "tool": "show_variants", "args": { "slide": "s-libre", "variants": [
          { "label": "Un", "ops": [{ "op": "set_param", "target": { "slide": "s-libre", "element": "e-texte" }, "param": "body", "value": [{ "runs": [{ "t": "Variante un" }] }] }] },
          { "label": "Deux", "ops": [{ "op": "set_param", "target": { "slide": "s-libre", "element": "e-texte" }, "param": "body", "value": [{ "runs": [{ "t": "Variante deux" }] }] }] }
        ] } },
        { "tool": "report", "args": { "title": "Deux variantes proposées", "facts": ["Un : texte court", "Deux : texte long"], "slide": "s-libre" } }
      ],
      "chunks": ["Voici deux variantes."]
    },
    {
      "tool_calls": [{ "id": "t4", "title": "Lire la slide" }],
      "mcp": [
        { "tool": "ask_choice", "args": { "question": "Laquelle ?", "options": [
          { "id": "a", "label": "A" }, { "id": "b", "label": "B" }
        ], "anchor": { "slide": "s-libre", "owner": "e-texte" } } },
        { "tool": "report", "args": { "title": "Choix noté", "facts": ["la réponse sera suivie"] } }
      ]
    },
    {
      "tool_calls": [{ "id": "t5", "title": "Lire la slide" }, { "id": "t6", "title": "Changer le fond" }],
      "mcp": [
        { "tool": "report", "args": { "title": "Fond bleu nuit", "facts": ["titre en blanc"], "slide": "s-libre", "actions": [{ "label": "Autre couleur" }] } }
      ]
    },
    {
      "tool_calls": [{ "id": "t7", "title": "Lire le thème" }],
      "mcp": [
        { "tool": "ask_choice", "args": { "question": "Quelle couleur ?", "options": [
          { "id": "n", "label": "Nuit" }, { "id": "s", "label": "Sable" }
        ] } },
        { "tool": "report", "args": { "title": "Couleur retenue", "facts": ["le fond suivra"] } }
      ]
    },
    {
      "parallel": true,
      "tool_calls": [{ "id": "t8", "title": "Lire le titre" }, { "id": "t9", "title": "Lire la police" }],
      "mcp": [
        { "tool": "ask_choice", "args": { "question": "Quel titre ?", "options": [
          { "id": "c", "label": "Court" }, { "id": "l", "label": "Long" }
        ] } },
        { "tool": "ask_choice", "args": { "question": "Quelle police ?", "options": [
          { "id": "s", "label": "Serif" }, { "id": "g", "label": "Grotesque" }
        ] } }
      ]
    }
  ],
  "sessions": {
    "2": [
      {
        "tool_calls": [{ "id": "t1", "title": "Lire la slide" }],
        "mcp": [
          { "tool": "apply", "args": { "label": "Titre : second onglet", "ops": [
            { "op": "set_param", "target": { "slide": "s-1" }, "param": "title", "value": "Second onglet, bonjour" }
          ] } },
          { "tool": "report", "args": { "title": "Titre du second onglet", "facts": ["« Second onglet, bonjour »"], "slide": "s-1" } }
        ],
        "chunks": ["Titre changé."]
      }
    ]
  }
}
