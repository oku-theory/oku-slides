    "layout": "default",
    "blocks": [
     {
      "id": "b-format-loro",
      "kind": "text",
      "params": {
       "body": [
        {
         "runs": [
          {
           "t": "Historique dans le fichier",
           "bold": true
          },
          {
           "t": " : chaque version passée se revoit et se restaure à partir du seul PDF."
          }
         ],
         "list": "bullet"
        },
        {
         "runs": [
          {
           "t": "Fusion sans conflit",
           "bold": true
          },
          {
           "t": " : deux copies modifiées séparément se recombinent ; un PDF changé sur disque est fusionné à l'enregistrement."
          }
         ],
         "list": "bullet"
        },
        {
         "runs": [
          {
           "t": "Le JSON n'est qu'une vue",
           "bold": true
          },
          {
           "t": " : le deck JSON v5 est la relecture canonique du replica."
          }
         ],
         "list": "bullet"
        },
        {
         "runs": [
          {
           "t": "Quatre sortes de champs",
           "bold": true
          },
          {
           "t": " : listes ordonnées à id (items, données), prose, prose riche à marques, et le reste en dernier écrivain gagne. Les slides et leurs éléments forment un seul arbre : déplacer un élément d'un slot ou d'une slide à l'autre garde les éditions concurrentes, et annuler un retrait rend le même élément."
          }
         ],
         "list": "bullet"
        }
       ]
      }
     }
    ]
   }
