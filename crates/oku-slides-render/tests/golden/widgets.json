          {
            "id": "c2",
            "kind": "card",
            "params": {
              "title": "Mise en avant",
              "highlight": true,
              "body": [
                {
                  "list": "number",
                  "runs": [
                    {
                      "t": "Un"
                    }
                  ]
                },
                {
                  "list": "number",
                  "runs": [
                    {
                      "t": "Deux"
                    }
                  ]
                }
              ]
            }
          },
          {
            "id": "c3",
            "kind": "card",
            "params": {
              "kicker": "Sans corps",
