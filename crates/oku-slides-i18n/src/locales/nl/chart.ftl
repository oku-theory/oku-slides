chart-invalid-option = ongeldige opties: { $reason }
chart-patch-dataset = een optiepatch kan `dataset` niet wijzigen: gebruik set_chart_data
chart-patch-object = de patch moet een JSON-object zijn
chart-render = de grafiek kon niet worden getekend
chart-data-no-row = rij { $row } bestaat niet
chart-data-no-column = kolom { $col } bestaat niet ({ $width } kolommen)
chart-data-insert-row = kan geen rij invoegen op { $at }
chart-data-remove-row = kan rij { $at } niet verwijderen
chart-data-insert-column = kan geen kolom invoegen op { $at }
chart-data-too-many-cells = meer cellen dan rijen
chart-data-remove-column = kan kolom { $at } niet verwijderen
chart-data-keep-header = de tabel moet zijn kopregel behouden
chart-no-series = er is minstens één reeks nodig
chart-dataset-header = dataset.source moet minstens de kopregel bevatten
chart-unknown-column = kolom ‘{ $name }’ staat niet in de dataset (kolommen: { $columns })
chart-column-out-of-range = kolom { $index } valt buiten de dataset ({ $count } kolommen)
chart-no-default-column = geen kolom { $index } in de dataset: geef `encode` op
chart-category-data = zonder dataset heeft de categorie-as `data` nodig
chart-mixed-series = een reeks van het type { $kind } kan niet worden gecombineerd met staven of lijnen
chart-horizontal-lines = lijnen worden horizontaal niet ondersteund
chart-series-numbers = reeks { $index }: de gegevens moeten getallen zijn
chart-series-empty = reeks { $index } heeft geen gegevens
chart-single-series = een grafiek van het type { $kind } heeft precies één reeks
chart-pie-item = pie: elk gegevensitem moet {"{"} name, value {"}"} zijn
chart-pie-empty = cirkeldiagram zonder gegevens
chart-scatter-mixed = een spreidingsdiagram kan niet worden gecombineerd met andere typen
chart-scatter-point = reeks { $index }: elk punt moet [x, y] zijn
chart-radar-indicators = radar zonder dataset: `radar.indicator` is verplicht
chart-radar-item = radar: elk gegevensitem moet {"{"} name, value: [..] {"}"} zijn
chart-radar-empty = radar zonder gegevens
chart-radar-values = radar: ‘{ $name }’ heeft { $values } waarden voor { $axes } assen
chart-default-series = Reeks { $n }
chart-default-category = Categorie
chart-default-value = Waarde
chart-default-name = Naam
chart-default-axis = As
chart-default-x = { $name } (x)
chart-patch-inline-data = met een dataset moeten de gegevens in de dataset blijven: bewerk ze met set_chart_data
chart-bad-color = ongeldige kleur: { $color } (verwacht #rgb of #rrggbb)
