# Spoken commands: comma-separated forms, matched whole, never with placeables.

voice-yes = oui, ouais, d'accord, ok, okay, bien sûr, confirme, confirmer, exact, affirmatif
voice-no = non, nan, annule, annuler, refuse, refuser
voice-negation = ne, n', pas, jamais

voice-stop = stop, arrête, arrête d'écouter, ça suffit, silence, tais-toi
voice-ordinal-1 = premier, première, un, une
voice-ordinal-2 = deuxième, second, seconde, deux
voice-ordinal-3 = troisième, trois
voice-ordinal-4 = quatrième, quatre
voice-ordinal-5 = cinquième, cinq
voice-ordinal-6 = sixième, six
voice-ordinal-7 = septième, sept
voice-ordinal-8 = huitième, huit
voice-ordinal-9 = neuvième, neuf

voice-next = suivant, suivante, diapo suivante, diapositive suivante, avance, avancer
voice-previous = précédent, précédente, diapo précédente, diapositive précédente, recule, reculer, retour
voice-first = première diapo, première diapositive, début, au début, retour au début
voice-last = dernière diapo, dernière diapositive, dernier, dernière, fin, à la fin
voice-exit = sortir, sors, quitter, quitte la présentation, quitter la présentation, échap

voice-wake = oku, okou, hé oku, hey oku, ok oku
voice-filler = s'il te plaît, s'il vous plaît, merci, euh, hum, hmm, alors, maintenant, bon, donc, le, la, les, l'
voice-option = option, numéro, choix

voice-verb-replace = remplacer, remplace, remplacez, écraser, écrase, écrasez
voice-verb-merge = fusionner, fusionne, fusionnez
voice-verb-discard = abandonner, abandonne, abandonnez, jeter, jette, jetez
voice-verb-delete = supprimer, supprime, supprimez, effacer, efface, effacez
voice-verb-use-api = utiliser l'API, utilise l'API, utilisez l'API, utiliser API, utilise API, passer à l'API
voice-verb-install = installer, installe, installez, mettre à jour, mets à jour, mise à jour
voice-verb-quit = quitter, quitte, quittez, fermer l'application, ferme l'application
voice-verb-close = fermer, ferme, fermez
voice-verb-import = importer, importe, importez

voice-say-question = { $question }
voice-say-option = Option { $n } : { $option }.
voice-say-confirm = Pour confirmer, dites « { $verb } », ou dites non.
voice-say-confirm-yes = Pour confirmer, dites oui, ou dites non.
voice-say-confirm-action = Pour { $action }, dites oui, ou dites non.
voice-action-open = ouvrir le fichier
voice-action-save = enregistrer la présentation
voice-action-save-copy = enregistrer une copie
voice-action-move = déplacer la présentation
voice-action-new-deck = créer une nouvelle présentation
voice-action-copy-pack = copier le pack
voice-action-copy-theme = copier le thème
voice-action-edit-theme = modifier le thème
voice-action-change-setting = changer le réglage
voice-action-change-dictation = changer la dictée
voice-action-download = télécharger le modèle
voice-action-select-agent = changer d'agent
voice-say-permission = L'agent demande une autorisation : dites oui pour autoriser une fois, ou non.
voice-say-agent-refused = L'agent a refusé la demande.
voice-say-agent-stopped = L'agent s'est arrêté.
voice-say-agent-no-start = L'agent n'a pas pu démarrer.
voice-say-agent-no-tools = Les outils de cet onglet sont indisponibles.
