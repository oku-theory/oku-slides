chart-invalid-option = nieprawidłowe opcje: { $reason }
chart-patch-dataset = łatka opcji nie może zmieniać `dataset`: użyj set_data
chart-patch-object = łatka musi być obiektem JSON
chart-render = nie udało się narysować wykresu
chart-data-no-row = wiersz { $row } nie istnieje
chart-data-no-column = kolumna { $col } nie istnieje (liczba kolumn: { $width })
chart-data-insert-row = nie można wstawić wiersza w pozycji { $at }
chart-data-remove-row = nie można usunąć wiersza { $at }
chart-data-insert-column = nie można wstawić kolumny w pozycji { $at }
chart-data-too-many-cells = więcej komórek niż wierszy
chart-data-remove-column = nie można usunąć kolumny { $at }
chart-data-keep-header = tabela musi zachować wiersz nagłówka
chart-no-series = wymagana jest co najmniej jedna seria
chart-dataset-header = dataset.source musi zawierać co najmniej wiersz nagłówka
chart-unknown-column = kolumny „{ $name }” nie ma w zbiorze danych (kolumny: { $columns })
chart-column-out-of-range = kolumna { $index } jest poza zbiorem danych (liczba kolumn: { $count })
chart-no-default-column = brak kolumny { $index } w zbiorze danych: podaj `encode`
chart-category-data = bez zbioru danych oś kategorii wymaga `data`
chart-mixed-series = seria typu { $kind } nie może być łączona ze słupkami ani liniami
chart-horizontal-lines = linie nie są obsługiwane w układzie poziomym
chart-series-numbers = seria { $index }: dane muszą być liczbami
chart-series-empty = seria { $index } nie ma danych
chart-single-series = wykres typu { $kind } ma dokładnie jedną serię
chart-pie-item = pie: każdy element danych musi mieć postać {"{"} name, value {"}"}
chart-pie-empty = wykres kołowy bez danych
chart-scatter-mixed = wykresu punktowego nie można łączyć z innymi typami
chart-scatter-point = seria { $index }: każdy punkt musi mieć postać [x, y]
chart-radar-indicators = radar bez zbioru danych: wymagane jest `radar.indicator`
chart-radar-item = radar: każdy element danych musi mieć postać {"{"} name, value: [..] {"}"}
chart-radar-empty = radar bez danych
chart-radar-values = radar: „{ $name }” ma { $values } wartości dla { $axes } osi
chart-default-series = Seria { $n }
chart-default-category = Kategoria
chart-default-value = Wartość
chart-default-name = Nazwa
chart-default-axis = Oś
chart-default-total = Suma
chart-default-x = { $name } (x)
chart-patch-inline-data = przy zbiorze danych dane muszą pozostać w zbiorze: edytuj je za pomocą set_data
chart-bad-color = nieprawidłowy kolor: { $color } (oczekiwano #rgb lub #rrggbb)
chart-waterfall-dataset = wykres kaskadowy odczytuje dane wyłącznie z dataset
chart-data-no-dataset = wykres nie ma tabeli danych (dataset)
chart-table-empty = tabela musi mieć co najmniej jeden wiersz i jedną kolumnę
chart-table-ragged = wszystkie wiersze tabeli muszą mieć tę samą liczbę komórek
chart-table-too-large = tabela ma co najwyżej { $rows } wierszy i { $columns } kolumn
chart-table-cell-too-long = komórka tabeli zawiera co najwyżej { $max } znaków
chart-table-not-finite = liczby w tabeli muszą być skończone
chart-table-align = align ma więcej wpisów niż tabela kolumn ({ $width })
