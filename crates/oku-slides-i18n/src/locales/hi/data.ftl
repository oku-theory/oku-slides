data-cell-type = एक मान कॉलम “{ $column }” में फ़िट नहीं होता, जिसमें { $type ->
    [number] संख्याएँ
    [integer] पूर्णांक
    [bool] सही या गलत
    [date] तारीखें (YYYY-MM-DD)
   *[text] अधिकतम 16 KB टेक्स्ट
} होते हैं
data-column-type = कॉलम “{ $column }” को बिना नुकसान { $type ->
    [number] संख्या कॉलम
    [integer] पूर्णांक कॉलम
    [bool] सही/गलत कॉलम
    [date] तारीख कॉलम
   *[text] टेक्स्ट कॉलम
} नहीं बनाया जा सकता, पंक्तियाँ देखें: { $rows }{ $more ->
    [0] {""}
   *[other] {" "}और { $more } अन्य
}
data-no-row = पंक्ति { $row } मौजूद नहीं है
data-no-column = कॉलम { $column } मौजूद नहीं है
data-id-taken = आईडी { $id } इस तालिका में पहले से उपयोग में है
data-id-invalid = आईडी “{ $id }” मान्य नहीं है: 1 से 64 अक्षर, अंक, - या _ उपयोग करें
data-id-missing = किसी नई पंक्ति, कॉलम या तालिका की आईडी नहीं है
data-too-large = { $what ->
    [rows] डेटा पंक्तियों की सीमा पार कर जाएगा (सीमा: { $max })
    [columns] डेटा कॉलम की सीमा पार कर जाएगा (सीमा: { $max })
    [text] एक टेक्स्ट सेल बाइट की सीमा पार कर जाएगा (सीमा: { $max })
   *[overlay] डेटा संपादित सेल की सीमा पार कर जाएगा (सीमा: { $max })
}
data-invalid-name = “{ $name }” मान्य डेटा नाम नहीं है: छोटे अक्षर, अंक और _ उपयोग करें, अंक से शुरू न करें
data-non-finite = परिमित न होने वाली संख्याएँ (NaN या अनंत): { $count }
data-columns-invalid = कॉलम सूची खाली है या किसी कॉलम का नाम दो बार लेती है
data-row-width = एक पंक्ति में तालिका के कॉलम से अधिक सेल हैं (कॉलम: { $max })
data-needs-base = यह डेटा अपनी पंक्तियाँ एक बेस फ़ाइल में रखता है, जिसे यह संपादन अभी नहीं पढ़ सकता
data-base-row-cells = बेस फ़ाइल वाली तालिका अपनी पंक्तियों की केवल आईडी देती है, सेल नहीं
data-row-cut = शीर्षक से अधिक सेल वाली पंक्तियाँ, अतिरिक्त सेल हटा दिए गए: { $count }
data-base-invalid = डेटा की आधार फ़ाइल क्षतिग्रस्त है या उसकी तालिका से मेल नहीं खाती
