# Spoken commands: comma-separated forms, matched whole, never with placeables.

voice-yes = evet, tamam, olur, onaylıyorum, onayla, doğru, kesinlikle, peki
voice-no = hayır, yok, iptal, iptal et, reddet
voice-negation = değil, asla, hiç, hiçbir

voice-stop = dur, dur artık, yeter, sus, dinlemeyi bırak, dinlemeyi durdur, stop
voice-ordinal-1 = birinci, bir
voice-ordinal-2 = ikinci, iki
voice-ordinal-3 = üçüncü, üç
voice-ordinal-4 = dördüncü, dört
voice-ordinal-5 = beşinci, beş
voice-ordinal-6 = altıncı, altı
voice-ordinal-7 = yedinci, yedi
voice-ordinal-8 = sekizinci, sekiz
voice-ordinal-9 = dokuzuncu, dokuz

voice-next = sonraki, sonraki slayt, ileri, devam, sıradaki
voice-previous = önceki, önceki slayt, geri, geri git
voice-first = ilk slayt, başa dön, başa git, en başa, baştan
voice-last = son slayt, son, sona git, en sona, sona
voice-exit = çık, çıkış, sunumdan çık, esc, escape

voice-wake = oku, hey oku, merhaba oku, ok oku
voice-filler = lütfen, teşekkürler, şey, ee, hım, şimdi, hadi
voice-option = seçenek, numara, madde

voice-verb-replace = değiştir, değiştirmek, üzerine yaz, üzerine yazmak
voice-verb-merge = birleştir, birleştirmek, birleştirelim
voice-verb-discard = çöpe at, vazgeç, vazgeçmek, değişiklikleri at
voice-verb-delete = sil, silmek, kaldır, kaldırmak
voice-verb-use-api = api kullan, api kullanmak, api'yi kullan
voice-verb-install = yükle, yüklemek, kur, kurmak, güncelle, güncellemek
voice-verb-quit = uygulamadan çık, uygulamayı kapat, uygulamayı kapatmak
voice-verb-close = kapat, kapatmak
voice-verb-import = içe aktar, içe aktarmak, aktar

voice-say-question = { $question }
voice-say-option = Seçenek { $n }: { $option }.
voice-say-confirm = Onaylamak için “{ $verb }” deyin ya da hayır deyin.
voice-say-confirm-yes = Onaylamak için evet deyin ya da hayır deyin.
voice-say-permission = Ajan bir izin istiyor: bir kez izin vermek için evet deyin ya da hayır.
voice-say-agent-refused = Ajan isteği reddetti.
voice-say-agent-stopped = Ajan durdu.
voice-say-agent-no-start = Ajan başlatılamadı.
voice-say-agent-no-tools = Bu sekmenin araçları kullanılamıyor.
