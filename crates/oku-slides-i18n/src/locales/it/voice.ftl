# Spoken commands: comma-separated forms, matched whole, never with placeables.

voice-yes = sì, si, certo, ok, okay, va bene, confermo, confermare, esatto, d'accordo, affermativo
voice-no = no, annulla, annullare, rifiuta, rifiutare
voice-negation = non, mai, nemmeno, neanche

voice-stop = stop, basta, fermati, ferma, silenzio, smetti di ascoltare, smetti
voice-ordinal-1 = primo, prima, uno, una
voice-ordinal-2 = secondo, seconda, due
voice-ordinal-3 = terzo, terza, tre
voice-ordinal-4 = quarto, quarta, quattro
voice-ordinal-5 = quinto, quinta, cinque
voice-ordinal-6 = sesto, sesta, sei
voice-ordinal-7 = settimo, settima, sette
voice-ordinal-8 = ottavo, ottava, otto
voice-ordinal-9 = nono, nona, nove

voice-next = avanti, successiva, successivo, diapositiva successiva, slide successiva, prossima, prossimo, prossima diapositiva
voice-previous = indietro, precedente, diapositiva precedente, slide precedente, torna indietro
voice-first = prima diapositiva, prima slide, inizio, all'inizio, torna all'inizio
voice-last = ultima diapositiva, ultima slide, ultima, ultimo, fine, alla fine
voice-exit = esci, uscire, esci dalla presentazione, escape, esc

voice-wake = oku, ciao oku, ehi oku, ok oku
voice-filler = per favore, per piacere, grazie, ehm, eh, allora, adesso, ora, il, lo, la, gli, le, l'
voice-option = opzione, numero, voce, scelta

voice-verb-replace = sostituire, sostituisci, sovrascrivere, sovrascrivi
voice-verb-merge = unire, unisci, fondere, fondi, combinare, combina
voice-verb-discard = scartare, scarta, buttare, butta, abbandonare, abbandona
voice-verb-delete = eliminare, elimina, cancellare, cancella, rimuovere, rimuovi
voice-verb-use-api = usare l'API, usa l'API, usare API, usa API, utilizzare l'API, utilizza l'API
voice-verb-install = installare, installa, aggiornare, aggiorna
voice-verb-quit = chiudere l'applicazione, chiudi l'applicazione, chiudi l'app, termina l'app, termina l'applicazione
voice-verb-close = chiudere, chiudi
voice-verb-import = importare, importa

voice-say-question = { $question }
voice-say-option = Opzione { $n }: { $option }.
voice-say-confirm = Per confermare, di' «{ $verb }», oppure di' no.
voice-say-confirm-yes = Per confermare, di' sì, oppure di' no.
voice-say-confirm-action = Per { $action }, di' sì, oppure di' no.
voice-action-open = aprire il file
voice-action-save = salvare la presentazione
voice-action-save-copy = salvare una copia
voice-action-move = spostare la presentazione
voice-action-new-deck = creare una nuova presentazione
voice-action-copy-pack = copiare il pacchetto
voice-action-copy-theme = copiare il tema
voice-action-edit-theme = modificare il tema
voice-action-change-setting = cambiare l'impostazione
voice-action-change-dictation = cambiare la dettatura
voice-action-download = scaricare il modello
voice-action-select-agent = cambiare agente
voice-say-permission = L'agente chiede un'autorizzazione: di' sì per consentire una volta, o no.
voice-say-agent-refused = L'agente ha rifiutato la richiesta.
voice-say-agent-stopped = L'agente si è fermato.
voice-say-agent-no-start = L'agente non è riuscito ad avviarsi.
voice-say-agent-no-tools = Gli strumenti di questa scheda non sono disponibili.
