# Spoken commands: comma-separated forms, matched whole, never with placeables.

voice-yes = sim, claro, ok, okay, certo, confirmo, confirmar, correto, afirmativo, pode ser
voice-no = não, nope, cancelar, cancela, recusar, recusa
voice-negation = nunca, jamais, nem, tampouco

voice-stop = pare, para, parar, chega, silêncio, pare de ouvir, para de ouvir
voice-ordinal-1 = primeiro, primeira, um, uma
voice-ordinal-2 = segundo, segunda, dois, duas
voice-ordinal-3 = terceiro, terceira, três
voice-ordinal-4 = quarto, quarta, quatro
voice-ordinal-5 = quinto, quinta, cinco
voice-ordinal-6 = sexto, sexta, seis
voice-ordinal-7 = sétimo, sétima, sete
voice-ordinal-8 = oitavo, oitava, oito
voice-ordinal-9 = nono, nona, nove

voice-next = próximo, próxima, próximo slide, seguinte, slide seguinte, avançar, avança
voice-previous = anterior, slide anterior, voltar, volta, retroceder, retrocede
voice-first = primeiro slide, início, ao início, começo, no começo, voltar ao início
voice-last = último slide, último, última, fim, no fim, ao final, final
voice-exit = sair, sai, sair da apresentação, escape, esc

voice-wake = oku, oi oku, ei oku, ok oku
voice-filler = por favor, obrigado, obrigada, hum, ahn, agora, então, o, a, os, as
voice-option = opção, número, item, escolha

voice-verb-replace = substituir, substitui, sobrescrever, sobrescreve
voice-verb-merge = mesclar, mescla, mesclo, fundir, funde, combinar, combina
voice-verb-discard = descartar, descarta, jogar fora, joga fora, abandonar, abandona
voice-verb-delete = excluir, exclui, apagar, apaga, remover, remove
voice-verb-use-api = usar a API, usar API, usa a API, usa API, utilizar a API, utilizar API
voice-verb-install = instalar, instala, atualizar, atualiza
voice-verb-quit = fechar o aplicativo, fecha o aplicativo, fechar o app, fecha o app, encerrar o app, encerrar o aplicativo
voice-verb-close = fechar, fecha
voice-verb-import = importar, importa

voice-say-question = { $question }
voice-say-option = Opção { $n }: { $option }.
voice-say-confirm = Para confirmar, diga «{ $verb }», ou diga não.
voice-say-confirm-yes = Para confirmar, diga sim, ou diga não.
voice-say-confirm-action = Para { $action }, diga sim, ou diga não.
voice-action-open = abrir o arquivo
voice-action-save = salvar a apresentação
voice-action-save-copy = salvar uma cópia
voice-action-move = mover a apresentação
voice-action-new-deck = criar uma nova apresentação
voice-action-copy-pack = copiar o pacote
voice-action-copy-theme = copiar o tema
voice-action-edit-theme = alterar o tema
voice-action-change-setting = alterar a configuração
voice-action-change-dictation = alterar o ditado
voice-action-download = baixar o modelo
voice-action-select-agent = trocar de agente
voice-say-permission = O agente pede uma permissão: diga sim para permitir uma vez, ou não.
voice-say-agent-refused = O agente recusou o pedido.
voice-say-agent-stopped = O agente parou.
voice-say-agent-no-start = O agente não conseguiu iniciar.
voice-say-agent-no-tools = As ferramentas desta aba estão indisponíveis.
