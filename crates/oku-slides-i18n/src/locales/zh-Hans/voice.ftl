# Spoken commands: comma-separated forms, matched whole, never with placeables.

voice-yes = 是, 是的, 对, 好, 好的, 行, 可以, 确认, 没错, 当然, ok
voice-no = 不, 不是, 不要, 否, 取消, 拒绝, 不行
voice-negation = 别, 勿, 没, 没有, 千万别, 绝不

voice-stop = 停, 停止, 停下, 够了, 安静, 别听了, 停止监听
voice-ordinal-1 = 第一, 第一个, 一, 首个
voice-ordinal-2 = 第二, 第二个, 二, 两
voice-ordinal-3 = 第三, 第三个, 三
voice-ordinal-4 = 第四, 第四个, 四
voice-ordinal-5 = 第五, 第五个, 五
voice-ordinal-6 = 第六, 第六个, 六
voice-ordinal-7 = 第七, 第七个, 七
voice-ordinal-8 = 第八, 第八个, 八
voice-ordinal-9 = 第九, 第九个, 九

voice-next = 下一个, 下一张, 下一页, 下一张幻灯片, 下一页幻灯片, 继续
voice-previous = 上一个, 上一张, 上一页, 上一张幻灯片, 返回, 后退
voice-first = 第一张, 第一页, 第一张幻灯片, 开头, 回到开头, 回到第一张, 最前面
voice-last = 最后一张, 最后一页, 最后一张幻灯片, 末尾, 到末尾, 最后
voice-exit = 退出, 退出演示, 退出放映, 离开, 离开演示, esc

voice-wake = oku, hey oku, 奥库, 欧库, 嘿奥库, 嘿 奥库, 你好奥库
voice-filler = 请, 请你, 谢谢, 呃, 嗯, 那么, 现在, 帮我
voice-option = 选项, 编号

voice-verb-replace = 替换, 覆盖, 替代, 覆盖掉
voice-verb-merge = 合并, 合并吧, 融合
voice-verb-discard = 丢弃, 放弃, 舍弃, 扔掉
voice-verb-delete = 删除, 删掉, 移除, 清除
voice-verb-use-api = 使用 api, 用 api, 使用api, 用api
voice-verb-install = 安装, 更新, 安装更新, 升级
voice-verb-quit = 退出应用, 退出程序, 关闭应用, 关闭程序
voice-verb-close = 关闭, 关掉, 关闭标签页, 关闭标签
voice-verb-import = 导入, 引入, 导入文件

voice-say-question = { $question }
voice-say-option = 选项 { $n }：{ $option }。
voice-say-confirm = 要确认，请说“{ $verb }”，或者说不。
voice-say-confirm-yes = 要确认，请说是，或者说不。
voice-say-confirm-action = 要{ $action }，请说是，或者说不。
voice-action-open = 打开文件
voice-action-save = 保存演示文稿
voice-action-save-copy = 保存副本
voice-action-move = 移动演示文稿
voice-action-new-deck = 新建演示文稿
voice-action-copy-pack = 复制资源包
voice-action-copy-theme = 复制主题
voice-action-edit-theme = 修改主题
voice-action-change-setting = 更改设置
voice-action-change-dictation = 更改听写
voice-action-download = 下载模型
voice-action-select-agent = 更换代理
voice-say-permission = 代理请求一项权限：说“是”允许一次，或说“不”。
voice-say-agent-refused = 智能体拒绝了请求。
voice-say-agent-stopped = 智能体已停止。
voice-say-agent-no-start = 智能体无法启动。
voice-say-agent-no-tools = 此标签页的工具不可用。
