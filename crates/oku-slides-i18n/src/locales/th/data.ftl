data-cell-type = ค่าหนึ่งไม่เข้ากับคอลัมน์ “{ $column }” ซึ่งเก็บ{ $type ->
    [number] ตัวเลข
    [integer] จำนวนเต็ม
    [bool] จริงหรือเท็จ
    [date] วันที่ (YYYY-MM-DD)
   *[text] ข้อความไม่เกิน 16 KB
}
data-column-type = เปลี่ยนคอลัมน์ “{ $column }” เป็น{ $type ->
    [number] คอลัมน์ตัวเลข
    [integer] คอลัมน์จำนวนเต็ม
    [bool] คอลัมน์จริง/เท็จ
    [date] คอลัมน์วันที่
   *[text] คอลัมน์ข้อความ
}โดยไม่สูญเสียข้อมูลไม่ได้ ดูแถว { $rows }{ $more ->
    [0] {""}
   *[other] {" "}และแถวอื่นอีก { $more } รายการ
}
data-no-row = ไม่มีแถว { $row }
data-no-column = ไม่มีคอลัมน์ { $column }
data-id-taken = รหัส { $id } ถูกใช้ในตารางนี้แล้ว
data-id-invalid = รหัส “{ $id }” ไม่ถูกต้อง: ใช้ตัวอักษร ตัวเลข - หรือ _ 1 ถึง 64 ตัว
data-id-missing = แถว คอลัมน์ หรือตารางใหม่ไม่มีรหัส
data-too-large = { $what ->
    [rows] ข้อมูลจะเกินขีดจำกัดแถว { $max } รายการ
    [columns] ข้อมูลจะเกินขีดจำกัดคอลัมน์ { $max } รายการ
    [text] เซลล์ข้อความจะเกินขีดจำกัด { $max } ไบต์
   *[overlay] ข้อมูลจะเกินขีดจำกัดเซลล์ที่แก้ไข { $max } รายการ
}
data-invalid-name = “{ $name }” ไม่ใช่ชื่อข้อมูลที่ถูกต้อง: ใช้อักษรตัวเล็ก ตัวเลข และ _ โดยไม่ขึ้นต้นด้วยตัวเลข
data-non-finite = ตัวเลข { $count } รายการไม่เป็นค่าจำกัด (NaN หรืออนันต์)
data-columns-invalid = รายการคอลัมน์ว่างหรือระบุคอลัมน์ซ้ำ
data-row-width = แถวหนึ่งมีเซลล์มากกว่าคอลัมน์ของตาราง { $max } รายการ
data-needs-base = ข้อมูลนี้เก็บแถวไว้ในไฟล์ฐานซึ่งการแก้ไขนี้ยังอ่านไม่ได้
data-base-row-cells = ตารางที่มีไฟล์ฐานระบุเฉพาะรหัสของแถว ไม่ระบุเซลล์
data-row-cut = แถว { $count } รายการมีเซลล์มากกว่าส่วนหัว จึงลบเซลล์ที่เกินออกแล้ว
data-base-invalid = ไฟล์ฐานของข้อมูลเสียหายหรือไม่ตรงกับตาราง
data-source-mismatch = แหล่งที่มาของข้อมูลไม่ตรงกับชนิด: ข้อมูลที่ป้อนเองมีตาราง ข้อมูลคิวรีมีคิวรี
data-inline-query = ข้อมูลคิวรีฝังในมุมมองไม่ได้: ข้อมูลที่ฝังมาจากตารางเสมอ
data-query-parse = อ่านคิวรีไม่ได้: ตรวจสอบบรรทัด { $line } คอลัมน์ { $column }
data-query-construct = คิวรีใช้ “{ $construct }” ซึ่งคิวรีข้อมูลไม่รองรับ
data-query-too-long = คิวรียาวเกิน { $max } ไบต์
data-query-too-deep = คิวรีซ้อนกันลึกเกินไป
data-query-rewrite = ไม่สามารถเตรียมคิวรีสำหรับเอนจินได้ นี่เป็นข้อบกพร่องของ Oku Slides
data-query-unknown-function = คิวรีเรียก “{ $function }” ซึ่งคิวรีข้อมูลไม่รองรับ
data-query-run = คิวรีล้มเหลว: { $reason }
data-query-input-failed = อินพุต “{ $input }” ล้มเหลว
data-query-too-large = { $what ->
    [rows] ผลลัพธ์ของคิวรีเกินขีดจำกัดแถว { $max } รายการ ผลลัพธ์จะไม่ถูกตัดทอน
    [columns] ผลลัพธ์ของคิวรีเกินขีดจำกัดคอลัมน์ { $max } รายการ ผลลัพธ์จะไม่ถูกตัดทอน
   *[text] เซลล์ข้อความในผลลัพธ์ของคิวรีเกินขีดจำกัด { $max } ไบต์ ผลลัพธ์จะไม่ถูกตัดทอน
}
data-query-column-type = คอลัมน์ผลลัพธ์ “{ $column }” มีชนิดที่ข้อมูลเก็บไม่ได้ ให้แปลงเป็นข้อความ ตัวเลข จำนวนเต็ม ค่าบูลีน หรือวันที่
data-query-duplicate-column = คอลัมน์ผลลัพธ์สองคอลัมน์ชื่อ “{ $column }” ให้เปลี่ยนชื่อคอลัมน์หนึ่งด้วย AS
data-query-float-operand = ใช้ “{ $function }” กับ “{ $operand }” ไม่ได้ เพราะมีเลขทศนิยม ให้แปลงเป็นจำนวนเต็มก่อน
data-query-timeout = คิวรีทำงานนานเกิน { $seconds } วินาทีจึงถูกหยุด
