chart-invalid-option = options invalides : { $reason }
chart-patch-dataset = le patch d'options ne peut pas modifier `dataset` : utiliser edit_data
chart-patch-object = le patch doit être un objet JSON
chart-render = le graphique n'a pas pu être dessiné
chart-ids-length = dataset.ids demande un id par ligne et dataset.columns un par colonne
chart-ids-duplicate = un id de ligne ou de colonne est répété
chart-ids-invalid = un id de ligne ou de colonne a de 1 à 64 lettres, chiffres, - ou _
chart-no-series = au moins une série est requise
chart-unknown-column = colonne « { $name } » absente du dataset (colonnes : { $columns })
chart-column-out-of-range = colonne { $index } hors du dataset ({ $count } colonnes)
chart-no-default-column = pas de colonne { $index } dans le dataset : préciser `encode`
chart-category-data = sans dataset, l'axe des catégories doit avoir `data`
chart-mixed-series = une série { $kind } ne peut pas être combinée avec des barres ou des lignes
chart-horizontal-lines = les lignes ne sont pas supportées en horizontal
chart-series-numbers = série { $index } : les données doivent être des nombres
chart-series-empty = série { $index } sans données
chart-single-series = un graphique { $kind } a exactement une série
chart-pie-item = camembert : chaque élément de data doit être {"{"} name, value {"}"}
chart-pie-empty = camembert sans données
chart-scatter-mixed = un nuage de points ne se combine pas avec d'autres types
chart-scatter-point = série { $index } : chaque point doit être [x, y]
chart-radar-indicators = radar sans dataset : `radar.indicator` est requis
chart-radar-item = radar : chaque élément de data doit être {"{"} name, value: [..] {"}"}
chart-radar-empty = radar sans données
chart-radar-values = radar : « { $name } » a { $values } valeurs pour { $axes } axes
chart-default-series = Série { $n }
chart-default-category = Catégorie
chart-default-value = Valeur
chart-default-name = Nom
chart-default-axis = Axe
chart-default-total = Total
chart-default-x = { $name } (x)
chart-patch-inline-data = avec un dataset, les données restent dans le dataset : modifiez-les avec edit_data
chart-bad-color = couleur invalide : { $color } (attendu : #rgb ou #rrggbb)
chart-waterfall-dataset = une cascade lit ses données uniquement dans dataset
chart-no-dataset = le graphique n'a pas de tableau de données (dataset)
chart-table-empty = le tableau doit avoir au moins une ligne et une colonne
chart-table-ragged = toutes les lignes du tableau doivent avoir le même nombre de cellules
chart-table-too-large = un tableau a au plus { $rows } lignes et { $columns } colonnes
chart-table-cell-too-long = une cellule de tableau contient au plus { $max } caractères
chart-table-not-finite = les nombres du tableau doivent être finis
chart-table-chart-option = chart doit être un objet d'options de graphique
chart-table-chart-columns = chart-columns doit lister des identifiants de colonnes valides et distincts (1 à 64 lettres, chiffres, - ou _)
chart-table-geometry = column-widths et row-heights donnent un poids fini et positif par colonne ou par ligne
chart-axis-interval = l’intervalle (interval) d’un axe doit être un nombre supérieur à 0
chart-axis-bounds = le maximum (max) d’un axe doit être supérieur à son minimum (min)
chart-bar-gap = barCategoryGap ne va que sur une série de barres : un pourcentage de 0 % à moins de 100 %, ou une longueur en points positive ou nulle
chart-ref-and-inline = une option ne peut pas porter une référence de données et des données en ligne : n’en garder qu’une
chart-ref-null = `data` ne peut pas valoir null : retirer la clé à la place
chart-columns-invalid = `columns` exige `data` et liste de 1 à 64 identifiants de colonne valides et distincts
