cli-reading = 正在读取 { $path }
cli-invalid-deck = 演示文稿无效：{ $path }
cli-deck-valid = 演示文稿有效：{ $slides }张幻灯片
cli-deck-issue = 问题：{ $issue }
cli-rendered = { $pages }页 → { $out }（编译 { $compile }，SVG { $svg }）
cli-asset-added = 资源 { $path } → { $id }
cli-saved = { $path }：{ $pages }页，PDF { $pdf } KB，源文件 { $sources } KB
cli-opened = { $path }：{ $slides }张幻灯片，{ $assets }个资源，{ $fonts }个字体
cli-extracted = 已提取到 { $dir }
cli-stripped = { $path }：不含源文件的副本
cli-pdf-modified = 此 PDF 在 Oku Slides 之后被其他工具修改过
cli-iterations = --iterations 必须大于 0
cli-no-block = 演示文稿中没有可编辑的区块
cli-blob-missing = 未找到源文件数据块
cli-roundtrip-mismatch = 重新读取的演示文稿与保存的不一致
cli-bench-world = 构建环境（字体）          { $time }
cli-bench-first = 首次编译                  { $time }  ({ $pages }页)
cli-bench-same = 无改动重新编译            { $time }
cli-bench-edited-text = 已编辑文本 { $n }
cli-bench-edit = set_text 后重新编译       { $time }
cli-bench-svg = 所有幻灯片的 SVG          { $time }  (每张 { $each })
cli-bench-pdf = PDF 导出                  { $time }  ({ $size } KB)
cli-bench-embed = 嵌入源文件数据块          { $time }
cli-bench-extract = 读回数据块                { $time }
cli-bench-roundtrip = 演示文稿往返              一致
cli-bench-history = 历史步骤                  平均 { $mean } ms，p50 { $p50 } ms
cli-serving = Oku Slides（开发）运行于 http://{ $host }:{ $port }
cli-serving-token = 请打开 { $url }（令牌在服务器停止前有效）
cli-models-dir = 听写模型：{ $dir }
cli-stopped = 服务器已停止
cli-not-found = 未找到
cli-bad-request = 请求无效：{ $reason }
cli-sse-full = 已打开的事件流过多
cli-forbidden = 请求被拒绝：并非来自本地界面
cli-unauthorized = 请求被拒绝：缺少访问令牌或令牌错误
cli-exposed = 正在 { $host } 上监听：服务器可从网络访问；只有出示本次启动令牌的客户端才会得到服务。如不需要网络，请将 [serve] host 保持为 127.0.0.1
cli-imported = { $path }：{ $slides }张幻灯片，{ $pages }页，{ $losses }处损失，{ $requests }个小组件请求
cli-import-pack-required = retrofit 模式需要 --pack：模板包的 ID、文件夹或名称
cli-import-write-failed = 无法写入导入的演示文稿 { $path }
cli-import-hifi-no-target = --pack 和 --theme 仅用于 retrofit 模式：高保真导入（--mode hifi）会生成自己的模板包和主题
cli-import-reference-hifi-only = --reference 属于 hifi 模式：retrofit 导入不与参考渲染比较
cli-import-scored = 与 { $witness } 的视觉差异：平均 { $mean }，超过 { $threshold } 的幻灯片 { $above ->
   *[other] { $above }张
}
cli-import-unscored = { $reason }

cli-about = 渲染并存储 Oku Slides 演示文稿
cli-arg-fonts = 额外字体文件夹（TTF/OTF）；默认：设置中的 paths.fonts
cli-cmd-check = 检查演示文稿
cli-arg-deck = 演示文稿（JSON）
cli-cmd-render = 将每张幻灯片渲染为 SVG，并附带元素边框
cli-arg-input = deck.json 或 .oku-slides.pdf 文件
cli-arg-out = 输出文件夹
cli-arg-theme = 替换演示文稿的主题：内置主题或库中的主题，按名称指定
cli-cmd-save = 将演示文稿保存为 .oku-slides.pdf（PDF + 源文件数据块）
cli-arg-output = 要写入的文件
cli-arg-assets = 资源文件夹：每个文件成为一个 sha256:… 资源
cli-arg-embed-fonts = 同时将 --fonts 的字体嵌入源文件
cli-cmd-open = 重新打开 .oku-slides.pdf：提取演示文稿及其资源
cli-arg-extract = 写入 deck.json、assets/ 和 fonts/ 的文件夹
cli-cmd-strip = 复制 .oku-slides.pdf，但不含源文件数据块
cli-cmd-bench = 测量编译和导出时间
cli-arg-iterations = 每个步骤的测量次数
cli-cmd-schema = 输出操作的 JSON schema
cli-cmd-serve = 开发服务器：在浏览器中运行界面，无需 Tauri
cli-arg-serve-input = 要打开的演示文稿（.oku-slides.pdf 或 .json）
cli-arg-port = 端口；默认：设置中的 serve.port
cli-arg-ui = 已构建界面的文件夹（ui/dist）
cli-cmd-import = 将 PowerPoint 演示文稿（.pptx）导入为 .oku-slides.pdf
cli-arg-pptx = PowerPoint 演示文稿（.pptx）
cli-arg-mode = retrofit：把内容放到现有的模板包和主题上；hifi：忠实副本，使用为其生成的模板包和主题
cli-arg-pack = 目标模板包：ID、模板包文件夹（pack.json、widgets/）或名称
cli-arg-import-theme = 目标主题：内置主题或库中的主题，按 ID 或名称指定；默认：默认主题
cli-arg-report = 同时写出导入报告（JSON）：损失、替代、覆盖率
cli-arg-no-system-fonts = 在 hifi 模式下，不在系统字体中查找演示文稿的字体
cli-arg-reference = 在 hifi 模式下，将每张幻灯片与演示文稿的参考渲染比较：auto（默认，office2pdf）、office2pdf、soffice（LibreOffice）或不比较（none）
