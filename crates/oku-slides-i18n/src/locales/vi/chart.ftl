chart-invalid-option = tùy chọn không hợp lệ: { $reason }
chart-patch-dataset = bản vá tùy chọn không thể thay đổi `dataset`: hãy dùng edit_data
chart-patch-object = bản vá phải là một đối tượng JSON
chart-render = không thể vẽ biểu đồ
chart-ids-length = dataset.ids cần một id cho mỗi hàng và dataset.columns một id cho mỗi cột
chart-ids-duplicate = một id hàng hoặc cột bị lặp lại
chart-ids-invalid = một id hàng hoặc cột gồm 1 đến 64 chữ cái, chữ số, - hoặc _
chart-no-series = cần ít nhất một chuỗi dữ liệu
chart-unknown-column = cột “{ $name }” không có trong dataset (các cột: { $columns })
chart-column-out-of-range = cột { $index } nằm ngoài dataset ({ $count } cột)
chart-no-default-column = không có cột { $index } trong dataset: hãy chỉ định `encode`
chart-category-data = khi không có dataset, trục danh mục cần `data`
chart-mixed-series = chuỗi { $kind } không thể kết hợp với cột hoặc đường
chart-horizontal-lines = không hỗ trợ đường theo chiều ngang
chart-series-numbers = chuỗi { $index }: dữ liệu phải là số
chart-series-empty = chuỗi { $index } không có dữ liệu
chart-single-series = biểu đồ { $kind } chỉ có đúng một chuỗi
chart-pie-item = tròn: mỗi mục dữ liệu phải là {"{"} name, value {"}"}
chart-pie-empty = biểu đồ tròn không có dữ liệu
chart-scatter-mixed = biểu đồ phân tán không thể kết hợp với loại khác
chart-scatter-point = chuỗi { $index }: mỗi điểm phải là [x, y]
chart-radar-indicators = radar không có dataset: cần có `radar.indicator`
chart-radar-item = radar: mỗi mục dữ liệu phải là {"{"} name, value: [..] {"}"}
chart-radar-empty = radar không có dữ liệu
chart-radar-values = radar: “{ $name }” có { $values } giá trị cho { $axes } trục
chart-default-series = Chuỗi { $n }
chart-default-category = Danh mục
chart-default-value = Giá trị
chart-default-name = Tên
chart-default-axis = Trục
chart-default-total = Tổng
chart-default-x = { $name } (x)
chart-patch-inline-data = khi có dataset, dữ liệu phải nằm trong dataset: hãy sửa bằng edit_data
chart-bad-color = màu không hợp lệ: { $color } (cần #rgb hoặc #rrggbb)
chart-waterfall-dataset = biểu đồ thác nước chỉ đọc dữ liệu từ dataset
chart-no-dataset = biểu đồ không có bảng dữ liệu (dataset)
chart-table-empty = bảng cần có ít nhất một hàng và một cột
chart-table-ragged = mọi hàng của bảng phải có cùng số ô
chart-table-too-large = một bảng có tối đa { $rows } hàng và { $columns } cột
chart-table-cell-too-long = một ô của bảng chứa tối đa { $max } ký tự
chart-table-not-finite = các số trong bảng phải hữu hạn
chart-table-chart-option = chart phải là một đối tượng tùy chọn biểu đồ
chart-table-chart-columns = chart-columns phải liệt kê các mã định danh cột hợp lệ và khác nhau (1 đến 64 chữ cái, chữ số, - hoặc _)
chart-table-geometry = column-widths và row-heights cho một trọng số hữu hạn, dương cho mỗi cột hoặc hàng
chart-axis-interval = khoảng chia (interval) của một trục phải là số lớn hơn 0
chart-axis-bounds = giá trị lớn nhất (max) của một trục phải lớn hơn giá trị nhỏ nhất (min)
chart-bar-gap = barCategoryGap chỉ dùng cho chuỗi cột: tỷ lệ phần trăm từ 0% đến dưới 100%, hoặc độ dài theo điểm từ 0 trở lên
chart-ref-and-inline = một tùy chọn không thể vừa có tham chiếu dữ liệu vừa có dữ liệu nội tuyến: chỉ giữ một
chart-ref-null = `data` không thể là null: hãy xóa khóa thay vào đó
chart-columns-invalid = `columns` cần `data` và liệt kê từ 1 đến 64 mã cột hợp lệ, khác nhau
