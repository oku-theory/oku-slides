# Spoken commands: comma-separated forms, matched whole, never with placeables.

voice-yes = vâng, dạ, ừ, được, đồng ý, ok, okay, chắc chắn, xác nhận, chính xác
voice-no = không, hủy, hủy bỏ, từ chối
voice-negation = đừng, chớ, chưa

voice-stop = dừng, dừng lại, thôi, đủ rồi, im đi, ngừng nghe, dừng nghe
voice-ordinal-1 = đầu tiên, thứ nhất, một
voice-ordinal-2 = thứ hai, thứ nhì, hai
voice-ordinal-3 = thứ ba, ba
voice-ordinal-4 = thứ tư, thứ bốn, bốn
voice-ordinal-5 = thứ năm, năm
voice-ordinal-6 = thứ sáu, sáu
voice-ordinal-7 = thứ bảy, bảy
voice-ordinal-8 = thứ tám, tám
voice-ordinal-9 = thứ chín, chín

voice-next = tiếp theo, tiếp, slide tiếp theo, slide sau, kế tiếp, tới
voice-previous = trước, slide trước, slide trước đó, quay lại, lùi lại, trước đó
voice-first = slide đầu, slide đầu tiên, về đầu, quay về đầu, bắt đầu
voice-last = slide cuối, slide cuối cùng, cuối, cuối cùng, về cuối, đến cuối
voice-exit = thoát, thoát ra, thoát trình chiếu, thoát khỏi trình chiếu, escape

voice-wake = oku, hey oku, ôku, ê oku, chào oku
voice-filler = làm ơn, xin, cảm ơn, ờ, ừm, bây giờ, thì, cái, các
voice-option = lựa chọn, tùy chọn, số

voice-verb-replace = thay thế, thay, ghi đè, ghi đè lên
voice-verb-merge = hợp nhất, gộp, gộp lại, trộn, merge
voice-verb-discard = bỏ, bỏ đi, vứt, vứt bỏ
voice-verb-delete = xóa, xoá, xóa bỏ, gỡ bỏ
voice-verb-use-api = dùng api, sử dụng api, dùng giao diện api
voice-verb-install = cài đặt, cài, cập nhật, cài bản cập nhật
voice-verb-quit = thoát ứng dụng, thoát app, đóng ứng dụng
voice-verb-close = đóng, đóng lại, đóng tab
voice-verb-import = nhập, nhập vào, import, nhập tệp

voice-say-question = { $question }
voice-say-option = Lựa chọn { $n }: { $option }.
voice-say-confirm = Để xác nhận, hãy nói “{ $verb }”, hoặc nói không.
voice-say-confirm-yes = Để xác nhận, hãy nói có, hoặc nói không.
voice-say-permission = Tác tử yêu cầu một quyền: hãy nói vâng để cho phép một lần, hoặc không.
voice-say-agent-refused = Tác nhân AI đã từ chối yêu cầu.
voice-say-agent-stopped = Tác nhân AI đã dừng.
voice-say-agent-no-start = Tác nhân AI không thể khởi động.
voice-say-agent-no-tools = Các công cụ của thẻ này không khả dụng.
