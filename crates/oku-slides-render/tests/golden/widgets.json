      }
    },
    {
      "id": "s-flux",
      "kind": "content",
      "params": {
        "title": "Flux",
        "kicker": "Surtitre",
        "blocks": [
          {
            "id": "t1",
            "style": {
              "size": "subtitle",
              "color": "accent",
              "align": "center",
              "leading": "tight"
            },
            "kind": "text",
            "params": {
              "body": [
                {
                  "runs": [
                    {
                      "t": "Texte "
                    },
                    {
                      "t": "gras",
                      "bold": true
                    },
                    {
                      "t": " et "
                    },
                    {
                      "t": "pastille",
                      "highlight": 2
                    }
                  ]
                }
              ]
            }
          },
          {
            "id": "c1",
            "kind": "card",
            "params": {
              "kicker": "Blague",
              "title": "Toto et la géographie",
              "body": [
                {
                  "runs": [
                    {
                      "t": "La maîtresse : « Où se trouve la Seine ? »"
                    }
                  ]
                },
                {
                  "list": "bullet",
                  "runs": [
                    {
                      "t": "Dans son lit !"
                    }
                  ]
                }
              ]
            }
          },
          {
            "id": "g1",
            "kind": "chart",
            "params": {
              "option": {
                "dataset": {
                  "source": [
                    [
                      "Mois",
                      "Ventes"
                    ],
                    [
                      "Jan",
                      3
                    ],
                    [
                      "Fév",
                      5
                    ]
                  ]
                },
                "xAxis": {
                  "type": "category"
                },
                "series": [
                  {
                    "type": "bar"
                  }
                ]
              }
            }
          },
          {
            "id": "tb1",
            "kind": "table",
            "params": {
              "data": {
                "dataset": {
                  "source": [
                    [
                      "Mois",
                      "Ventes",
                      "Marge"
                    ],
                    [
                      "Jan",
                      3,
                      0.2
                    ],
                    [
                      "Fév",
                      5,
                      0.25
                    ]
                  ]
                },
                "header-column": true,
                "striped": true
              }
            }
          }
        ]
      }
    },
    {
      "id": "s-colonnes",
      "kind": "content",
      "params": {
