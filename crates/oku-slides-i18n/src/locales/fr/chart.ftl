chart-invalid-option = options invalides : { $reason }
chart-patch-dataset = le patch d'options ne peut pas modifier `dataset` : utiliser set_chart_data
chart-patch-object = le patch doit être un objet JSON
chart-render = le graphique n'a pas pu être dessiné
chart-data-no-row = ligne { $row } inexistante
chart-data-no-column = colonne { $col } inexistante ({ $width } colonnes)
chart-data-insert-row = insertion de ligne en { $at } impossible
chart-data-remove-row = suppression de la ligne { $at } impossible
chart-data-insert-column = insertion de colonne en { $at } impossible
chart-data-too-many-cells = plus de cellules que de lignes
chart-data-remove-column = suppression de la colonne { $at } impossible
chart-data-keep-header = le tableau doit garder sa ligne d'en-têtes
chart-no-series = au moins une série est requise
chart-dataset-header = dataset.source doit contenir au moins la ligne d'en-têtes
chart-unknown-column = colonne « { $name } » absente du dataset (colonnes : { $columns })
chart-column-out-of-range = colonne { $index } hors du dataset ({ $count } colonnes)
chart-no-default-column = pas de colonne { $index } dans le dataset : préciser `encode`
chart-category-data = sans dataset, l'axe des catégories doit avoir `data`
chart-mixed-series = une série { $kind } ne peut pas être combinée avec des barres ou des lignes
chart-horizontal-lines = les lignes ne sont pas supportées en horizontal
chart-series-numbers = série { $index } : les données doivent être des nombres
chart-series-empty = série { $index } sans données
chart-single-series = un graphique { $kind } a exactement une série
chart-pie-item = camembert : chaque élément de data doit être {"{"} name, value {"}"}
chart-pie-empty = camembert sans données
chart-scatter-mixed = un nuage de points ne se combine pas avec d'autres types
chart-scatter-point = série { $index } : chaque point doit être [x, y]
chart-radar-indicators = radar sans dataset : `radar.indicator` est requis
chart-radar-item = radar : chaque élément de data doit être {"{"} name, value: [..] {"}"}
chart-radar-empty = radar sans données
chart-radar-values = radar : « { $name } » a { $values } valeurs pour { $axes } axes
chart-default-series = Série { $n }
chart-default-category = Catégorie
chart-default-value = Valeur
chart-default-name = Nom
chart-default-axis = Axe
chart-default-total = Total
chart-default-x = { $name } (x)
chart-patch-inline-data = avec un dataset, les données restent dans le dataset : modifiez-les avec set_chart_data
chart-bad-color = couleur invalide : { $color } (attendu : #rgb ou #rrggbb)
chart-waterfall-dataset = une cascade lit ses données uniquement dans dataset
