data-cell-type = एक मान कॉलम “{ $column }” में फ़िट नहीं होता, जिसमें { $type ->
    [number] संख्याएँ
    [integer] पूर्णांक
    [bool] सही या गलत
    [date] तारीखें (YYYY-MM-DD)
   *[text] अधिकतम 16 KB टेक्स्ट
} होते हैं
data-column-type = कॉलम “{ $column }” को बिना नुकसान { $type ->
    [number] संख्या कॉलम
    [integer] पूर्णांक कॉलम
    [bool] सही/गलत कॉलम
    [date] तारीख कॉलम
   *[text] टेक्स्ट कॉलम
} नहीं बनाया जा सकता, पंक्तियाँ देखें: { $rows }{ $more ->
    [0] {""}
   *[other] {" "}और { $more } अन्य
}
data-no-row = पंक्ति { $row } मौजूद नहीं है
data-no-column = कॉलम { $column } मौजूद नहीं है
data-id-taken = आईडी { $id } इस तालिका में पहले से उपयोग में है
data-id-invalid = आईडी “{ $id }” मान्य नहीं है: 1 से 64 अक्षर, अंक, - या _ उपयोग करें
data-id-missing = किसी नई पंक्ति, कॉलम या तालिका की आईडी नहीं है
data-too-large = { $what ->
    [rows] डेटा पंक्तियों की सीमा पार कर जाएगा (सीमा: { $max })
    [columns] डेटा कॉलम की सीमा पार कर जाएगा (सीमा: { $max })
    [text] एक टेक्स्ट सेल बाइट की सीमा पार कर जाएगा (सीमा: { $max })
   *[overlay] डेटा संपादित सेल की सीमा पार कर जाएगा (सीमा: { $max })
}
data-invalid-name = “{ $name }” मान्य डेटा नाम नहीं है: छोटे अक्षर, अंक और _ उपयोग करें, अंक से शुरू न करें
data-non-finite = परिमित न होने वाली संख्याएँ (NaN या अनंत): { $count }
data-columns-invalid = कॉलम सूची खाली है या किसी कॉलम का नाम दो बार लेती है
data-row-width = एक पंक्ति में तालिका के कॉलम से अधिक सेल हैं (कॉलम: { $max })
data-needs-base = यह डेटा अपनी पंक्तियाँ एक बेस फ़ाइल में रखता है, जिसे यह संपादन अभी नहीं पढ़ सकता
data-base-row-cells = बेस फ़ाइल वाली तालिका अपनी पंक्तियों की केवल आईडी देती है, सेल नहीं
data-row-cut = शीर्षक से अधिक सेल वाली पंक्तियाँ, अतिरिक्त सेल हटा दिए गए: { $count }
data-base-invalid = डेटा की आधार फ़ाइल क्षतिग्रस्त है या उसकी तालिका से मेल नहीं खाती
data-source-mismatch = डेटा का स्रोत उसके प्रकार से मेल नहीं खाता: मैनुअल डेटा में तालिका होती है, क्वेरी डेटा में क्वेरी
data-inline-query = क्वेरी डेटा इनलाइन नहीं हो सकता: इनलाइन डेटा हमेशा किसी तालिका से आता है
data-query-parse = क्वेरी पढ़ी नहीं जा सकती: पंक्ति { $line }, कॉलम { $column } जाँचें
data-query-construct = क्वेरी “{ $construct }” का उपयोग करती है, जिसे डेटा क्वेरी समर्थित नहीं करतीं
data-query-too-long = क्वेरी { $max } बाइट से लंबी है
data-query-too-deep = क्वेरी बहुत गहराई तक नेस्टेड है
data-query-rewrite = इंजन के लिए क्वेरी तैयार नहीं की जा सकी; यह Oku Slides की एक गड़बड़ी है
data-query-unknown-function = क्वेरी “{ $function }” को कॉल करती है, जिसे डेटा क्वेरी समर्थित नहीं करतीं
data-query-run = क्वेरी विफल रही: { $reason }
data-query-input-failed = इसका इनपुट “{ $input }” विफल रहा
data-query-too-large = { $what ->
    [rows] क्वेरी का परिणाम पंक्तियों की सीमा पार कर गया (सीमा: { $max }); परिणाम कभी काटा नहीं जाता
    [columns] क्वेरी का परिणाम कॉलम की सीमा पार कर गया (सीमा: { $max }); परिणाम कभी काटा नहीं जाता
   *[text] परिणाम का एक टेक्स्ट सेल बाइट की सीमा पार कर गया (सीमा: { $max }); परिणाम कभी काटा नहीं जाता
}
data-query-column-type = परिणाम कॉलम “{ $column }” का प्रकार डेटा में नहीं रखा जा सकता: इसे टेक्स्ट, संख्या, पूर्णांक, बूलियन या तारीख में बदलें
data-query-duplicate-column = परिणाम के दो कॉलम का नाम “{ $column }” है: AS से इनमें से एक का नाम बदलें
data-query-float-operand = “{ $function }” को “{ $operand }” पर लागू नहीं किया जा सकता, क्योंकि उसमें दशमलव संख्याएँ हैं: पहले इसे पूर्णांक में बदलें
data-query-timeout = क्वेरी समय सीमा से अधिक चली (सीमा: { $seconds } सेकंड) और रोक दी गई
