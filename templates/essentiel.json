{
  "id": "essentiel",
  "name": "Essentiel",
  "description": "Les mises en page de base : texte, cartes, colonnes, chapitres.",
  "templates": [
    {
      "id": "texte",
      "name": "Texte",
      "description": "Un titre et une liste de points",
      "slide": {
        "kind": "content",
        "kicker": "Surtitre",
        "title": "Titre de la slide",
        "blocks": [
          {
            "id": "b",
            "kind": "text",
            "text": [
              {
                "list": "bullet",
                "runs": [
                  {
                    "t": "Premier point"
                  }
                ]
              },
              {
                "list": "bullet",
                "runs": [
                  {
                    "t": "Deuxième point"
                  }
                ]
              },
              {
                "list": "bullet",
                "runs": [
                  {
                    "t": "Troisième point"
                  }
                ]
              }
            ]
          }
        ],
        "id": "tpl-texte"
      }
    },
    {
      "id": "cartes",
      "name": "Trois cartes",
      "description": "Trois idées côte à côte, la dernière mise en avant",
      "slide": {
        "kind": "content",
        "kicker": "Surtitre",
        "title": "Trois idées",
        "layout": "columns",
        "blocks": [
          {
            "id": "c1",
            "kind": "card",
            "kicker": "Un",
            "title": "Première",
            "text": [
              {
                "list": "bullet",
                "runs": [
                  {
                    "t": "Détail"
                  }
                ]
              }
            ]
          },
          {
            "id": "c2",
            "kind": "card",
            "kicker": "Deux",
            "title": "Deuxième",
            "text": [
              {
                "list": "bullet",
                "runs": [
                  {
                    "t": "Détail"
                  }
                ]
              }
            ]
          },
          {
            "id": "c3",
            "kind": "card",
            "kicker": "Trois",
            "title": "Troisième",
            "highlight": true,
            "text": [
              {
                "list": "bullet",
                "runs": [
                  {
                    "t": "Détail"
                  }
                ]
              }
            ]
          }
        ],
        "id": "tpl-cartes"
      }
    },
    {
      "id": "colonnes",
      "name": "Deux colonnes",
      "description": "Comparer deux choses, ou un texte et son illustration",
      "slide": {
        "kind": "content",
        "title": "Avant, après",
        "layout": "split",
        "blocks": [
          {
            "id": "g",
            "kind": "text",
            "text": [
              {
                "runs": [
                  {
                    "t": "Avant"
                  }
                ]
              },
              {
                "list": "bullet",
                "runs": [
                  {
                    "t": "Ce qui était"
                  }
                ]
              },
              {
                "list": "bullet",
                "runs": [
                  {
                    "t": "Ce qui gênait"
                  }
                ]
              }
            ]
          },
          {
            "id": "d",
            "kind": "text",
            "text": [
              {
                "runs": [
                  {
                    "t": "Après"
                  }
                ]
              },
              {
                "list": "bullet",
                "runs": [
                  {
                    "t": "Ce qui change"
                  }
                ]
              },
              {
                "list": "bullet",
                "runs": [
                  {
                    "t": "Ce qu'on y gagne"
                  }
                ]
              }
            ]
          }
        ],
        "id": "tpl-colonnes"
      }
    },
    {
      "id": "citation",
      "name": "Citation",
      "description": "Une phrase forte, mise en valeur",
      "slide": {
        "kind": "content",
        "title": "Ce qu'il faut retenir",
        "layout": "quote",
        "blocks": [
          {
            "id": "q",
            "kind": "text",
            "text": [
              {
                "runs": [
                  {
                    "t": "« Une idée par slide. »"
                  }
                ]
              }
            ]
          }
        ],
        "id": "tpl-citation"
      }
    },
    {
      "id": "message",
      "name": "Message central",
      "description": "Un seul message, au centre",
      "slide": {
        "kind": "content",
        "layout": "center",
        "blocks": [
          {
            "id": "m",
            "kind": "text",
            "style": {
              "size": "subtitle",
              "font": "display",
              "align": "center"
            },
            "text": [
              {
                "runs": [
                  {
                    "t": "Le message principal"
                  }
                ]
              }
            ]
          }
        ],
        "id": "tpl-message"
      }
    },
    {
      "id": "libre",
      "name": "Libre",
      "description": "Des éléments à placer où vous voulez",
      "slide": {
        "kind": "content",
        "title": "Composition libre",
        "elements": [
          {
            "id": "f",
            "kind": "shape",
            "frame": {
              "x": 0,
              "y": 0,
              "w": 800,
              "h": 460
            },
            "style": {
              "fill": "surface",
              "radius": "md"
            }
          },
          {
            "id": "t",
            "kind": "text",
            "frame": {
              "x": 40,
              "y": 40,
              "w": 720,
              "h": 160
            },
            "style": {
              "size": "lead",
              "font": "display"
            },
            "text": [
              {
                "runs": [
                  {
                    "t": "Un texte placé librement"
                  }
                ]
              }
            ]
          }
        ],
        "id": "tpl-libre"
      }
    },
    {
      "id": "chapitre",
      "name": "Chapitre",
      "description": "Ouvre une partie, apparaît dans le sommaire",
      "slide": {
        "kind": "chapter",
        "title": "Nouvelle partie",
        "subtitle": "En une phrase",
        "id": "tpl-chapitre"
      }
    },
    {
      "id": "sommaire",
      "name": "Sommaire",
      "description": "La liste des chapitres, mise à jour seule",
      "slide": {
        "kind": "toc",
        "id": "tpl-sommaire"
      }
    },
    {
      "id": "couverture",
      "name": "Couverture",
      "description": "Titre, sous-titre, auteur et date du deck",
      "slide": {
        "kind": "title",
        "id": "tpl-couverture"
      }
    },
    {
      "id": "fin",
      "name": "Fin",
      "description": "La dernière slide",
      "slide": {
        "kind": "end",
        "text": "Merci",
        "id": "tpl-fin"
      }
    }
  ]
}