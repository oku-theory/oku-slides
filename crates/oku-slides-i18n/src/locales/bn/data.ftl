data-cell-type = একটি মান কলাম “{ $column }”-এ খাপ খায় না, যাতে থাকে { $type ->
    [number] সংখ্যা
    [integer] পূর্ণসংখ্যা
    [bool] সত্য বা মিথ্যা
    [date] তারিখ (YYYY-MM-DD)
   *[text] সর্বোচ্চ 16 KB লেখা
}
data-column-type = কলাম “{ $column }”-কে ক্ষতি ছাড়া { $type ->
    [number] সংখ্যার কলাম
    [integer] পূর্ণসংখ্যার কলাম
    [bool] সত্য/মিথ্যা কলাম
    [date] তারিখের কলাম
   *[text] লেখার কলাম
} করা যায় না, সারিগুলো দেখুন: { $rows }{ $more ->
    [0] {""}
   *[other] {" "}এবং আরও { $more }টি
}
data-no-row = সারি { $row } নেই
data-no-column = কলাম { $column } নেই
data-id-taken = আইডি { $id } এই টেবিলে আগেই ব্যবহৃত
data-id-invalid = আইডি “{ $id }” বৈধ নয়: 1 থেকে 64টি অক্ষর, অঙ্ক, - বা _ ব্যবহার করুন
data-id-missing = নতুন সারি, কলাম বা টেবিলের আইডি নেই
data-too-large = { $what ->
    [rows] ডেটা সারির সীমা ছাড়িয়ে যাবে (সীমা: { $max })
    [columns] ডেটা কলামের সীমা ছাড়িয়ে যাবে (সীমা: { $max })
    [text] একটি লেখার ঘর বাইটের সীমা ছাড়িয়ে যাবে (সীমা: { $max })
   *[overlay] ডেটা সম্পাদিত ঘরের সীমা ছাড়িয়ে যাবে (সীমা: { $max })
}
data-invalid-name = “{ $name }” বৈধ ডেটা নাম নয়: ছোট হাতের অক্ষর, অঙ্ক ও _ ব্যবহার করুন, অঙ্ক দিয়ে শুরু করবেন না
data-non-finite = { $count }টি সংখ্যা সসীম নয় (NaN বা অসীম)
data-columns-invalid = কলামের তালিকা খালি বা একটি কলাম দুবার উল্লেখ করে
data-row-width = একটি সারিতে টেবিলের { $max }টি কলামের চেয়ে বেশি ঘর আছে
data-needs-base = এই ডেটা তার সারিগুলো একটি বেস ফাইলে রাখে, যা এই সম্পাদনা এখনও পড়তে পারে না
data-base-row-cells = বেস ফাইলযুক্ত টেবিল তার সারিগুলোর শুধু আইডি দেয়, ঘর নয়
data-row-cut = { $count }টি সারিতে শিরোনামের চেয়ে বেশি ঘর ছিল; বাড়তি ঘরগুলো সরানো হয়েছে
data-base-invalid = ডেটার ভিত্তি ফাইলটি ক্ষতিগ্রস্ত অথবা তার টেবিলের সাথে মেলে না
data-source-mismatch = ডেটার উৎস তার ধরনের সাথে মেলে না: ম্যানুয়াল ডেটায় একটি টেবিল থাকে, কোয়েরি ডেটায় একটি কোয়েরি
data-inline-query = কোয়েরি ডেটা ইনলাইন হতে পারে না: ইনলাইন ডেটা সবসময় একটি টেবিল থেকে আসে
data-query-parse = কোয়েরিটি পড়া যাচ্ছে না: লাইন { $line }, কলাম { $column } দেখুন
data-query-construct = কোয়েরিটি “{ $construct }” ব্যবহার করে, যা ডেটা কোয়েরি সমর্থন করে না
data-query-too-long = কোয়েরিটি { $max } বাইটের চেয়ে দীর্ঘ
data-query-too-deep = কোয়েরিটি খুব গভীরভাবে নেস্টেড
data-query-rewrite = ইঞ্জিনের জন্য কোয়েরিটি প্রস্তুত করা যায়নি; এটি Oku Slides-এর একটি ত্রুটি
data-query-unknown-function = কোয়েরিটি “{ $function }” কল করে, যা ডেটা কোয়েরি সমর্থন করে না
data-query-run = কোয়েরিটি ব্যর্থ হয়েছে: { $reason }
data-query-input-failed = এর ইনপুট “{ $input }” ব্যর্থ হয়েছে
data-query-too-large = { $what ->
    [rows] কোয়েরির ফলাফল সারির সীমা ছাড়িয়েছে (সীমা: { $max }); ফলাফল কখনো ছাঁটা হয় না
    [columns] কোয়েরির ফলাফল কলামের সীমা ছাড়িয়েছে (সীমা: { $max }); ফলাফল কখনো ছাঁটা হয় না
   *[text] ফলাফলের একটি লেখার ঘর বাইটের সীমা ছাড়িয়েছে (সীমা: { $max }); ফলাফল কখনো ছাঁটা হয় না
}
data-query-column-type = ফলাফলের কলাম “{ $column }”-এর ধরন ডেটা রাখতে পারে না: এটিকে লেখা, সংখ্যা, পূর্ণসংখ্যা, বুলিয়ান বা তারিখে রূপান্তর করুন
data-query-duplicate-column = ফলাফলের দুটি কলামের নাম “{ $column }”: AS দিয়ে একটির নাম বদলান
data-query-float-operand = “{ $function }” “{ $operand }”-এ প্রয়োগ করা যায় না, কারণ এতে দশমিক সংখ্যা আছে: আগে এটিকে পূর্ণসংখ্যায় রূপান্তর করুন
data-query-timeout = কোয়েরিটি সময়ের সীমা ছাড়িয়েছে (সীমা: { $seconds } সেকেন্ড), তাই থামানো হয়েছে
