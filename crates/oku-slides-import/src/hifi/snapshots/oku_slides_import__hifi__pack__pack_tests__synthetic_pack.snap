// ==== _commun.typ ====
// Code partagé du pack généré par l'import : le champ d'un placeholder et
// le décor de chaque master.
#import "/oku-slides/lib.typ": field, color-of, font-of

/// Le champ `name` d'un placeholder : `body` dans sa boîte (pt page), à ses
/// marges `inset`, ancré en `anchor`. Vide, il garde sa boîte (l'éditeur la
/// montre) ; dans un texte, `{n}` est le numéro de la page.
#let champ(ctx, name, body, x, y, w, h, inset, anchor) = {
  let body = if body == none or body == "" { [] } else if type(body) == str and body.contains("{n}") {
    context body.replace("{n}", str(counter(page).get().first()))
  } else { body }
  place(top + left, dx: x, dy: y, block(width: w, height: h, inset: inset, align(anchor, field(ctx, name, body))))
}

/// Décor du master m1.
#let master-1(t, ctx) = {
  place(top + left, dx: 0pt, dy: 1040pt,
    rect(width: 1920pt, height: 40pt, fill: color-of(t, "accent"), stroke: (paint: color-of(t, "accent-2"), thickness: 2pt)),
  )
}
// ==== l2-blank.typ ====
// Widget de slide généré par l'import : le layout l2 (master m1).
#import "/oku-slides/lib.typ": widget, params as p, blank-slide, free-area, default-grid, color-of, font-of
#import "_commun.typ": champ, master-1

#let widget = widget("l2-blank", label: "blank", category: "slide",
  params: (
    "grid": p.grid(default: default-grid),
    "extras": p.slot(mode: "free"),
  ),
  (args, ctx) => blank-slide(id: ctx.id, {
    let t = ctx.tokens
    master-1(t, ctx)
    free-area(t, args.at("extras"), grid: args.at("grid"))
  }),
)
// ==== l3-titre-deux-contenus-et-pied.typ ====
// Widget de slide généré par l'import : le layout l3 (master m1).
#import "/oku-slides/lib.typ": widget, params as p, blank-slide, free-area, default-grid, color-of, font-of
#import "_commun.typ": champ, master-1

#let widget = widget("l3-titre-deux-contenus-et-pied", label: "Titre, deux contenus et pied", category: "slide",
  params: (
    "titre": p.rich(),
    "corps": p.rich(),
    "corps-2": p.rich(),
    "date": p.plain(),
    "pied": p.plain(),
    "numero": p.plain(default: "{n}"),
    "decor": p.flag(default: true),
    "grid": p.grid(default: default-grid),
    "extras": p.slot(mode: "free"),
  ),
  (args, ctx) => blank-slide(id: ctx.id, {
    let t = ctx.tokens
    place(top + left, rect(width: 1920pt, height: 1080pt, fill: tiling(size: (1920pt, 1080pt), box(width: 1920pt, height: 1080pt, if ctx.load != none { (ctx.load)(asset: "sha256:aa", fit: "stretch") })), stroke: none))
    if args.at("decor") {
      master-1(t, ctx)
      place(top + left, dx: 120pt, dy: 220pt,
        line(start: (0pt, 0pt), end: (1680pt, 0pt), stroke: (paint: color-of(t, "accent-2"), thickness: 2pt)),
      )
    }
    {
      set text(font: font-of(t, "body"), size: 80pt, fill: color-of(t, "ink"), weight: "bold", top-edge: 0.942em, bottom-edge: -0.258em)
      set par(leading: 0pt, spacing: 0pt, justify: false)
      set align(center)
      set list(indent: 0pt, spacing: 0pt)
      set enum(indent: 0pt, body-indent: 0.5em, spacing: 0pt)
      champ(ctx, "titre", args.at("titre"), 120pt, 60pt, 1680pt, 140pt, (top: 7.2pt, right: 14.4pt, bottom: 7.2pt, left: 14.4pt), horizon)
    }
    {
      set text(font: font-of(t, "body"), size: 48pt, fill: color-of(t, "ink"), top-edge: 0.942em, bottom-edge: -0.258em)
      set par(leading: 0pt, spacing: 0pt, justify: false)
      set align(left)
      set list(indent: 0pt, spacing: 0pt, body-indent: 0pt, marker: box(width: 54pt, text(font: font-of(t, "body"), size: 48pt, fill: color-of(t, "ink"), "•")))
      set enum(indent: 0pt, body-indent: 0.5em, spacing: 0pt)
      champ(ctx, "corps", args.at("corps"), 120pt, 260pt, 820pt, 680pt, (top: 7.2pt, right: 14.4pt, bottom: 7.2pt, left: 14.4pt), top)
    }
    {
      set text(font: font-of(t, "body"), size: 48pt, fill: color-of(t, "ink"), top-edge: 0.942em, bottom-edge: -0.258em)
      set par(leading: 0pt, spacing: 0pt, justify: false)
      set align(left)
      set list(indent: 0pt, spacing: 0pt, body-indent: 0pt, marker: box(width: 54pt, text(font: font-of(t, "body"), size: 48pt, fill: color-of(t, "ink"), "•")))
      set enum(indent: 0pt, body-indent: 0.5em, spacing: 0pt)
      champ(ctx, "corps-2", args.at("corps-2"), 980pt, 260pt, 820pt, 400pt, (top: 7.2pt, right: 14.4pt, bottom: 7.2pt, left: 14.4pt), top)
    }
    {
      set text(font: font-of(t, "body"), size: 24pt, fill: color-of(t, "ink"), top-edge: 0.942em, bottom-edge: -0.258em)
      set par(leading: 0pt, spacing: 0pt, justify: false)
      set align(right)
      set list(indent: 0pt, spacing: 0pt)
      set enum(indent: 0pt, body-indent: 0.5em, spacing: 0pt)
      champ(ctx, "date", args.at("date"), 120pt, 980pt, 400pt, 48pt, (top: 7.2pt, right: 14.4pt, bottom: 7.2pt, left: 14.4pt), top)
    }
    {
      set text(font: font-of(t, "body"), size: 24pt, fill: color-of(t, "ink"), top-edge: 0.942em, bottom-edge: -0.258em)
      set par(leading: 0pt, spacing: 0pt, justify: false)
      set align(right)
      set list(indent: 0pt, spacing: 0pt)
      set enum(indent: 0pt, body-indent: 0.5em, spacing: 0pt)
      champ(ctx, "pied", args.at("pied"), 560pt, 980pt, 800pt, 48pt, (top: 7.2pt, right: 14.4pt, bottom: 7.2pt, left: 14.4pt), top)
    }
    {
      set text(font: font-of(t, "body"), size: 24pt, fill: color-of(t, "ink"), top-edge: 0.942em, bottom-edge: -0.258em)
      set par(leading: 0pt, spacing: 0pt, justify: false)
      set align(right)
      set list(indent: 0pt, spacing: 0pt)
      set enum(indent: 0pt, body-indent: 0.5em, spacing: 0pt)
      champ(ctx, "numero", args.at("numero"), 1400pt, 980pt, 400pt, 48pt, (top: 7.2pt, right: 14.4pt, bottom: 7.2pt, left: 14.4pt), top)
    }
    free-area(t, args.at("extras"), grid: args.at("grid"))
  }),
)
