chart-invalid-option = invalid options: { $reason }
chart-patch-dataset = an option patch cannot change `dataset`: use set_chart_data
chart-patch-object = the patch must be a JSON object
chart-render = the chart could not be drawn
chart-data-no-row = row { $row } does not exist
chart-data-no-column = column { $col } does not exist ({ $width } columns)
chart-data-insert-row = cannot insert a row at { $at }
chart-data-remove-row = cannot remove row { $at }
chart-data-insert-column = cannot insert a column at { $at }
chart-data-too-many-cells = more cells than rows
chart-data-remove-column = cannot remove column { $at }
chart-data-keep-header = the table must keep its header row
chart-no-series = at least one series is required
chart-dataset-header = dataset.source must contain at least the header row
chart-unknown-column = column “{ $name }” is not in the dataset (columns: { $columns })
chart-column-out-of-range = column { $index } is outside the dataset ({ $count } columns)
chart-no-default-column = no column { $index } in the dataset: specify `encode`
chart-category-data = without a dataset, the category axis needs `data`
chart-mixed-series = a { $kind } series cannot be combined with bars or lines
chart-horizontal-lines = lines are not supported horizontally
chart-series-numbers = series { $index }: data must be numbers
chart-series-empty = series { $index } has no data
chart-single-series = a { $kind } chart has exactly one series
chart-pie-item = pie: each data item must be {"{"} name, value {"}"}
chart-pie-empty = pie chart without data
chart-scatter-mixed = a scatter plot cannot be combined with other types
chart-scatter-point = series { $index }: each point must be [x, y]
chart-radar-indicators = radar without a dataset: `radar.indicator` is required
chart-radar-item = radar: each data item must be {"{"} name, value: [..] {"}"}
chart-radar-empty = radar without data
chart-radar-values = radar: “{ $name }” has { $values } values for { $axes } axes
chart-default-series = Series { $n }
chart-default-category = Category
chart-default-value = Value
chart-default-name = Name
chart-default-axis = Axis
chart-default-x = { $name } (x)
chart-patch-inline-data = with a dataset, data must stay in the dataset: edit it with set_chart_data
chart-bad-color = invalid color: { $color } (expected #rgb or #rrggbb)
