data-cell-type = значення не підходить для стовпця «{ $column }», у якому { $type ->
    [number] числа
    [integer] цілі числа
    [bool] істина або хиба
    [date] дати (РРРР-ММ-ДД)
   *[text] текст не довший за 16 КБ
}
data-column-type = стовпець «{ $column }» не можна без втрат зробити { $type ->
    [number] числовим
    [integer] цілочисельним
    [bool] логічним
    [date] стовпцем дат
   *[text] текстовим
}, див. рядки { $rows }{ $more ->
    [0] {""}
    [one] {" "}і ще { $more } рядок
    [few] {" "}і ще { $more } рядки
   *[many] {" "}і ще { $more } рядків
}
data-no-row = рядка { $row } не існує
data-no-column = стовпця { $column } не існує
data-id-taken = ідентифікатор { $id } уже використовується в цій таблиці
data-id-invalid = ідентифікатор «{ $id }» недійсний: використовуйте від 1 до 64 латинських літер, цифр, - або _
data-id-missing = новий рядок, стовпець або таблиця не має ідентифікатора
data-too-large = { $what ->
    [rows] дані перевищили б межу рядків — { $max } { $max ->
        [one] рядок
        [few] рядки
       *[many] рядків
    }
    [columns] дані перевищили б межу стовпців — { $max } { $max ->
        [one] стовпець
        [few] стовпці
       *[many] стовпців
    }
    [text] текстова клітинка перевищила б межу — { $max } { $max ->
        [one] байт
        [few] байти
       *[many] байтів
    }
   *[overlay] дані перевищили б межу змінених клітинок — { $max } { $max ->
        [one] клітинка
        [few] клітинки
       *[many] клітинок
    }
}
data-invalid-name = «{ $name }» — недійсна назва даних: використовуйте малі латинські літери, цифри та _, не починаючи з цифри
data-non-finite = { $count ->
    [one] { $count } число не є скінченним (NaN або нескінченність)
    [few] { $count } числа не є скінченними (NaN або нескінченність)
   *[many] { $count } чисел не є скінченними (NaN або нескінченність)
}
data-columns-invalid = список стовпців порожній або називає стовпець двічі
data-row-width = у рядку більше клітинок, ніж { $max } { $max ->
    [one] стовпець
    [few] стовпці
   *[many] стовпців
} таблиці
data-needs-base = ці дані зберігають рядки в базовому файлі, який ця зміна поки не вміє читати
data-base-row-cells = таблиця з базовим файлом задає для рядків лише ідентифікатори, без клітинок
data-row-cut = { $count ->
    [one] { $count } рядок мав більше клітинок, ніж заголовок; зайві клітинки вилучено
    [few] { $count } рядки мали більше клітинок, ніж заголовок; зайві клітинки вилучено
   *[many] { $count } рядків мали більше клітинок, ніж заголовок; зайві клітинки вилучено
}
data-base-invalid = базовий файл даних пошкоджено або він не відповідає їхній таблиці
data-source-mismatch = джерело даних не відповідає їхньому виду: ручні дані містять таблицю, дані запиту — запит
data-inline-query = дані запиту не можуть бути вбудованими: вбудовані дані завжди беруться з таблиці
data-query-parse = запит не читається: перевірте рядок { $line }, стовпець { $column }
data-query-construct = запит використовує «{ $construct }», що запити даних не підтримують
data-query-too-long = запит перевищує межу — { $max } { $max ->
    [one] байт
    [few] байти
   *[many] байтів
}
data-query-too-deep = запит занадто глибоко вкладений
data-query-rewrite = не вдалося підготувати запит для рушія; це помилка Oku Slides
data-query-unknown-function = запит викликає «{ $function }», що запити даних не підтримують
data-query-run = запит завершився помилкою: { $reason }
data-query-input-failed = його вхід «{ $input }» завершився помилкою
data-query-too-large = { $what ->
    [rows] результат запиту перевищує межу — { $max } { $max ->
        [one] рядок
        [few] рядки
       *[many] рядків
    }; його ніколи не обрізають
    [columns] результат запиту перевищує межу — { $max } { $max ->
        [one] стовпець
        [few] стовпці
       *[many] стовпців
    }; його ніколи не обрізають
   *[text] текстова клітинка результату перевищує межу — { $max } { $max ->
        [one] байт
        [few] байти
       *[many] байтів
    }; результат ніколи не обрізають
}
data-query-column-type = стовпець результату «{ $column }» має тип, який дані не можуть зберігати: перетворіть його на текст, число, ціле, логічне значення або дату
data-query-duplicate-column = два стовпці результату називаються «{ $column }»: перейменуйте один із них за допомогою AS
data-query-float-operand = «{ $function }» не можна застосувати до «{ $operand }», де зберігаються дробові числа: спершу перетворіть його на ціле
data-query-timeout = запит виконувався довше за межу — { $seconds } { $seconds ->
    [one] секунда
    [few] секунди
   *[many] секунд
} — і його зупинено
