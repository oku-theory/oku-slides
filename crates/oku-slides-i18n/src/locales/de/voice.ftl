# Spoken commands: comma-separated forms, matched whole, never with placeables.

voice-yes = ja, jawohl, klar, genau, okay, ok, bestätigen, einverstanden
voice-no = nein, nö, abbrechen, ablehnen
voice-negation = nicht, nie, niemals, kein, keine, keinen

voice-stop = stopp, stop, hör auf, aufhören, genug, ruhe
voice-ordinal-1 = erste, erster, erstes, eins, ein, eine
voice-ordinal-2 = zweite, zweiter, zweites, zwei
voice-ordinal-3 = dritte, dritter, drittes, drei
voice-ordinal-4 = vierte, vierter, viertes, vier
voice-ordinal-5 = fünfte, fünfter, fünftes, fünf
voice-ordinal-6 = sechste, sechster, sechstes, sechs
voice-ordinal-7 = siebte, siebter, siebtes, sieben
voice-ordinal-8 = achte, achter, achtes, acht
voice-ordinal-9 = neunte, neunter, neuntes, neun

voice-next = weiter, nächste, nächster, nächste Folie, vorwärts
voice-previous = zurück, vorherige, vorherige Folie, vorige Folie
voice-first = erste Folie, Anfang, zum Anfang, an den Anfang
voice-last = letzte Folie, letzte, Ende, zum Ende, ans Ende
voice-exit = verlassen, Präsentation verlassen, raus, escape, esc

voice-wake = oku, hey oku, hallo oku, okay oku
voice-filler = bitte, mal, äh, ähm, jetzt, danke, dann, doch, der, die, das, den, dem
voice-option = Option, Nummer, Punkt, Auswahl

voice-verb-replace = ersetzen, ersetze, überschreiben, überschreibe
voice-verb-merge = zusammenführen, zusammenfügen, führe zusammen, mergen, vereinen
voice-verb-discard = verwerfen, verwirf, verwerfe, wegwerfen, wirf weg
voice-verb-delete = löschen, lösche, entfernen, entferne
voice-verb-use-api = API verwenden, API nutzen, API benutzen, verwende API, verwende die API, nutze die API
voice-verb-install = installieren, installiere, aktualisieren, aktualisiere
voice-verb-quit = beenden, beende, Anwendung beenden, App beenden
voice-verb-close = schließen, schließe, zumachen
voice-verb-import = importieren, importiere, import

voice-say-question = { $question }
voice-say-option = Option { $n }: { $option }.
voice-say-confirm = Zum Bestätigen sagen Sie „{ $verb }“, oder sagen Sie nein.
voice-say-confirm-yes = Zum Bestätigen sagen Sie ja, oder sagen Sie nein.
voice-say-permission = Der Agent bittet um eine Erlaubnis: Sagen Sie ja, um einmal zu erlauben, oder nein.
voice-say-agent-refused = Der Agent hat die Anfrage abgelehnt.
voice-say-agent-stopped = Der Agent wurde beendet.
voice-say-agent-no-start = Der Agent konnte nicht starten.
voice-say-agent-no-tools = Die Werkzeuge dieses Tabs sind nicht verfügbar.
