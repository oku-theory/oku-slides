data-cell-type = значение не подходит для столбца «{ $column }», в котором { $type ->
    [number] числа
    [integer] целые числа
    [bool] истина или ложь
    [date] даты (ГГГГ-ММ-ДД)
   *[text] текст не длиннее 16 КБ
}
data-column-type = столбец «{ $column }» нельзя без потерь сделать { $type ->
    [number] числовым
    [integer] целочисленным
    [bool] логическим
    [date] столбцом дат
   *[text] текстовым
}, см. строки { $rows }{ $more ->
    [0] {""}
    [one] {" "}и ещё { $more } строка
    [few] {" "}и ещё { $more } строки
   *[many] {" "}и ещё { $more } строк
}
data-no-row = строки { $row } не существует
data-no-column = столбца { $column } не существует
data-id-taken = идентификатор { $id } уже используется в этой таблице
data-id-invalid = идентификатор «{ $id }» недопустим: используйте от 1 до 64 латинских букв, цифр, - или _
data-id-missing = у новой строки, столбца или таблицы нет идентификатора
data-too-large = { $what ->
    [rows] данные превысили бы предел строк — { $max } { $max ->
        [one] строка
        [few] строки
       *[many] строк
    }
    [columns] данные превысили бы предел столбцов — { $max } { $max ->
        [one] столбец
        [few] столбца
       *[many] столбцов
    }
    [text] текстовая ячейка превысила бы предел — { $max } { $max ->
        [one] байт
        [few] байта
       *[many] байтов
    }
   *[overlay] данные превысили бы предел изменённых ячеек — { $max } { $max ->
        [one] ячейка
        [few] ячейки
       *[many] ячеек
    }
}
data-invalid-name = «{ $name }» — недопустимое имя данных: используйте строчные латинские буквы, цифры и _, не начиная с цифры
data-non-finite = { $count ->
    [one] { $count } число не является конечным (NaN или бесконечность)
    [few] { $count } числа не являются конечными (NaN или бесконечность)
   *[many] { $count } чисел не являются конечными (NaN или бесконечность)
}
data-columns-invalid = список столбцов пуст или называет столбец дважды
data-row-width = в строке больше ячеек, чем { $max } { $max ->
    [one] столбец
    [few] столбца
   *[many] столбцов
} таблицы
data-needs-base = эти данные хранят строки в базовом файле, который это изменение пока не умеет читать
data-base-row-cells = таблица с базовым файлом задаёт для строк только идентификаторы, без ячеек
data-row-cut = { $count ->
    [one] { $count } строка содержала больше ячеек, чем заголовок; лишние ячейки удалены
    [few] { $count } строки содержали больше ячеек, чем заголовок; лишние ячейки удалены
   *[many] { $count } строк содержали больше ячеек, чем заголовок; лишние ячейки удалены
}
data-base-invalid = базовый файл данных повреждён или не соответствует их таблице
data-source-mismatch = источник данных не соответствует их виду: ручные данные содержат таблицу, данные запроса — запрос
data-inline-query = данные запроса не могут быть встроенными: встроенные данные всегда берутся из таблицы
data-query-parse = запрос не читается: проверьте строку { $line }, столбец { $column }
data-query-construct = запрос использует «{ $construct }», что запросы данных не поддерживают
data-query-too-long = запрос превышает предел — { $max } { $max ->
    [one] байт
    [few] байта
   *[many] байтов
}
data-query-too-deep = запрос слишком глубоко вложен
data-query-rewrite = не удалось подготовить запрос для движка; это ошибка Oku Slides
data-query-unknown-function = запрос вызывает «{ $function }», что запросы данных не поддерживают
data-query-run = запрос завершился ошибкой: { $reason }
data-query-input-failed = его вход «{ $input }» завершился ошибкой
data-query-too-large = { $what ->
    [rows] результат запроса превышает предел — { $max } { $max ->
        [one] строка
        [few] строки
       *[many] строк
    }; он никогда не обрезается
    [columns] результат запроса превышает предел — { $max } { $max ->
        [one] столбец
        [few] столбца
       *[many] столбцов
    }; он никогда не обрезается
   *[text] текстовая ячейка результата превышает предел — { $max } { $max ->
        [one] байт
        [few] байта
       *[many] байтов
    }; результат никогда не обрезается
}
data-query-column-type = столбец результата «{ $column }» имеет тип, который данные не могут хранить: приведите его к тексту, числу, целому, логическому значению или дате
data-query-duplicate-column = два столбца результата называются «{ $column }»: переименуйте один из них с помощью AS
data-query-float-operand = «{ $function }» нельзя применить к «{ $operand }», где хранятся дробные числа: сначала приведите его к целому
data-query-timeout = запрос выполнялся дольше предела — { $seconds } { $seconds ->
    [one] секунда
    [few] секунды
   *[many] секунд
} — и был остановлен
