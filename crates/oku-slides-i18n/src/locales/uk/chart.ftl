chart-invalid-option = недопустимі параметри: { $reason }
chart-patch-dataset = зміна параметрів не може змінювати `dataset`: використовуйте set_data
chart-patch-object = зміна має бути об’єктом JSON
chart-render = не вдалося побудувати діаграму
chart-data-no-row = рядка { $row } не існує
chart-data-no-column = стовпця { $col } не існує (стовпців: { $width })
chart-data-insert-row = неможливо вставити рядок у позицію { $at }
chart-data-remove-row = неможливо видалити рядок { $at }
chart-data-insert-column = неможливо вставити стовпець у позицію { $at }
chart-data-too-many-cells = клітинок більше, ніж рядків
chart-data-remove-column = неможливо видалити стовпець { $at }
chart-data-keep-header = таблиця має зберегти рядок заголовків
chart-data-ids-length = dataset.ids потребує один id на рядок, а dataset.columns — один на стовпець
chart-data-ids-duplicate = id рядка або стовпця повторюється
chart-data-ids-invalid = id рядка або стовпця містить від 1 до 64 літер, цифр, - або _
chart-data-id-taken = цей id рядка або стовпця вже зайнятий
chart-no-series = потрібен принаймні один ряд
chart-dataset-header = dataset.source має містити принаймні рядок заголовків
chart-unknown-column = стовпця «{ $name }» немає в dataset (стовпці: { $columns })
chart-column-out-of-range = стовпець { $index } поза dataset (стовпців: { $count })
chart-no-default-column = у dataset немає стовпця { $index }: вкажіть `encode`
chart-category-data = без dataset осі категорій потрібні `data`
chart-mixed-series = ряд типу { $kind } не можна поєднувати зі стовпцями чи лініями
chart-horizontal-lines = горизонтальні лінії не підтримуються
chart-series-numbers = ряд { $index }: дані мають бути числами
chart-series-empty = ряд { $index } не містить даних
chart-single-series = діаграма типу { $kind } має рівно один ряд
chart-pie-item = pie: кожен елемент даних має бути {"{"} name, value {"}"}
chart-pie-empty = кругова діаграма без даних
chart-scatter-mixed = точкову діаграму не можна поєднувати з іншими типами
chart-scatter-point = ряд { $index }: кожна точка має бути [x, y]
chart-radar-indicators = radar без dataset: потрібен `radar.indicator`
chart-radar-item = radar: кожен елемент даних має бути {"{"} name, value: [..] {"}"}
chart-radar-empty = радарна діаграма без даних
chart-radar-values = radar: «{ $name }» має значень — { $values }, а осей — { $axes }
chart-default-series = Ряд { $n }
chart-default-category = Категорія
chart-default-value = Значення
chart-default-name = Назва
chart-default-axis = Вісь
chart-default-total = Разом
chart-default-x = { $name } (x)
chart-patch-inline-data = за наявності dataset дані мають залишатися в dataset: змінюйте їх через set_data
chart-bad-color = неприпустимий колір: { $color } (очікується #rgb або #rrggbb)
chart-waterfall-dataset = каскадна діаграма читає дані лише з dataset
chart-data-no-dataset = у діаграми немає таблиці даних (dataset)
chart-table-empty = у таблиці має бути хоча б один рядок і один стовпець
chart-table-ragged = усі рядки таблиці мають містити однакову кількість клітинок
chart-table-too-large = у таблиці не більше { $rows } рядків і { $columns } стовпців
chart-table-cell-too-long = клітинка таблиці містить не більше { $max } символів
chart-table-not-finite = числа в таблиці мають бути скінченними
chart-table-chart-option = chart має бути об'єктом параметрів діаграми
chart-table-chart-columns = chart-columns має містити дійсні та різні ідентифікатори стовпців (від 1 до 64 літер, цифр, - або _)
