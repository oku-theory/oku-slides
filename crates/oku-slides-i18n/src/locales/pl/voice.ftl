# Spoken commands: comma-separated forms, matched whole, never with placeables.

voice-yes = tak, jasne, ok, okej, zgoda, potwierdzam, potwierdź, dobrze, oczywiście, zgadza się
voice-no = nie, anuluj, anulować, odmawiam
voice-negation = nigdy, ani, wcale

voice-stop = stop, stój, przestań, przestań słuchać, dość, cicho, wystarczy
voice-ordinal-1 = pierwszy, pierwsza, pierwsze, jeden, jedna
voice-ordinal-2 = drugi, druga, drugie, dwa, dwie
voice-ordinal-3 = trzeci, trzecia, trzecie, trzy
voice-ordinal-4 = czwarty, czwarta, czwarte, cztery
voice-ordinal-5 = piąty, piąta, piąte, pięć
voice-ordinal-6 = szósty, szósta, szóste, sześć
voice-ordinal-7 = siódmy, siódma, siódme, siedem
voice-ordinal-8 = ósmy, ósma, ósme, osiem
voice-ordinal-9 = dziewiąty, dziewiąta, dziewiąte, dziewięć

voice-next = dalej, następny, następna, następny slajd, następne, naprzód, do przodu
voice-previous = wstecz, poprzedni, poprzednia, poprzedni slajd, cofnij, wróć
voice-first = pierwszy slajd, początek, na początek, do początku
voice-last = ostatni slajd, ostatni, ostatnia, koniec, na koniec, do końca
voice-exit = wyjdź, wyjście, wyjdź z prezentacji, zakończ prezentację, escape, esc

voice-wake = oku, hej oku, cześć oku, ok oku
voice-filler = proszę, dziękuję, yyy, eee, teraz, więc
voice-option = opcja, numer, pozycja

voice-verb-replace = zastąpić, zastąp, nadpisać, nadpisz
voice-verb-merge = scalić, scal, połączyć, połącz
voice-verb-discard = porzucić, porzuć, wyrzucić, wyrzuć, odrzucić, odrzuć
voice-verb-delete = usunąć, usuń, skasować, skasuj
voice-verb-use-api = użyj API, użyć API, używać API, użyj interfejsu API
voice-verb-install = zainstaluj, zainstalować, zaktualizuj, zaktualizować
voice-verb-quit = zamknij aplikację, zamknąć aplikację, wyjdź z aplikacji
voice-verb-close = zamknij, zamknąć
voice-verb-import = importuj, importować

voice-say-question = { $question }
voice-say-option = Opcja { $n }: { $option }.
voice-say-confirm = Aby potwierdzić, powiedz „{ $verb }” albo powiedz nie.
voice-say-confirm-yes = Aby potwierdzić, powiedz tak albo powiedz nie.
voice-say-confirm-action = Aby { $action }, powiedz tak albo powiedz nie.
voice-action-open = otworzyć plik
voice-action-save = zapisać prezentację
voice-action-save-copy = zapisać kopię
voice-action-move = przenieść prezentację
voice-action-new-deck = utworzyć nową prezentację
voice-action-copy-pack = skopiować pakiet
voice-action-copy-theme = skopiować motyw
voice-action-edit-theme = zmienić motyw
voice-action-change-setting = zmienić ustawienie
voice-action-change-dictation = zmienić dyktowanie
voice-action-download = pobrać model
voice-action-select-agent = zmienić agenta
voice-say-permission = Agent prosi o zgodę: powiedz tak, aby zezwolić raz, albo nie.
voice-say-agent-refused = Agent odrzucił żądanie.
voice-say-agent-stopped = Agent zatrzymał się.
voice-say-agent-no-start = Nie udało się uruchomić agenta.
voice-say-agent-no-tools = Narzędzia tej karty są niedostępne.
