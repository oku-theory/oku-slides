chart-invalid-option = 选项无效：{ $reason }
chart-patch-dataset = 选项补丁不能修改 `dataset`：请使用 set_data
chart-patch-object = 补丁必须是 JSON 对象
chart-render = 无法绘制图表
chart-data-no-row = 第 { $row } 行不存在
chart-data-no-column = 第 { $col } 列不存在（共 { $width } 列）
chart-data-insert-row = 无法在 { $at } 处插入行
chart-data-remove-row = 无法删除第 { $at } 行
chart-data-insert-column = 无法在 { $at } 处插入列
chart-data-too-many-cells = 单元格多于行数
chart-data-remove-column = 无法删除第 { $at } 列
chart-data-keep-header = 表格必须保留表头行
chart-data-ids-length = dataset.ids 需要每行一个 id，dataset.columns 需要每列一个
chart-data-ids-duplicate = 行或列的 id 重复
chart-data-ids-invalid = 行或列的 id 由 1 到 64个字母、数字、- 或 _ 组成
chart-data-id-taken = 该行或列的 id 已被使用
chart-no-series = 至少需要一个系列
chart-dataset-header = dataset.source 至少须包含表头行
chart-unknown-column = 列“{ $name }”不在 dataset 中（列：{ $columns }）
chart-column-out-of-range = 第 { $index } 列超出 dataset 范围（共 { $count } 列）
chart-no-default-column = dataset 中没有第 { $index } 列：请指定 `encode`
chart-category-data = 没有 dataset 时，类别轴需要 `data`
chart-mixed-series = { $kind } 系列不能与柱形或折线组合
chart-horizontal-lines = 折线不支持水平方向
chart-series-numbers = 系列 { $index }：数据必须是数字
chart-series-empty = 系列 { $index } 没有数据
chart-single-series = { $kind } 图表只能有一个系列
chart-pie-item = 饼图：每个 data 项必须为 {"{"} name, value {"}"}
chart-pie-empty = 饼图没有数据
chart-scatter-mixed = 散点图不能与其他类型组合
chart-scatter-point = 系列 { $index }：每个点必须为 [x, y]
chart-radar-indicators = 没有 dataset 的雷达图必须提供 `radar.indicator`
chart-radar-item = 雷达图：每个 data 项必须为 {"{"} name, value: [..] {"}"}
chart-radar-empty = 雷达图没有数据
chart-radar-values = 雷达图：“{ $name }”有 { $values }个值，但有 { $axes }条轴
chart-default-series = 系列 { $n }
chart-default-category = 类别
chart-default-value = 值
chart-default-name = 名称
chart-default-axis = 轴
chart-default-total = 合计
chart-default-x = { $name }（x）
chart-patch-inline-data = 使用 dataset 时，数据必须保留在 dataset 中：请用 set_data 编辑
chart-bad-color = 无效的颜色：{ $color }（应为 #rgb 或 #rrggbb）
chart-waterfall-dataset = 瀑布图只从 dataset 读取数据
chart-data-no-dataset = 图表没有数据表 (dataset)
chart-table-empty = 表格至少需要一行和一列
chart-table-ragged = 表格的每一行必须有相同数量的单元格
chart-table-too-large = 表格最多有 { $rows } 行和 { $columns } 列
chart-table-cell-too-long = 表格单元格最多包含 { $max }个字符
chart-table-not-finite = 表格中的数字必须是有限值
chart-table-chart-option = chart 必须是图表选项对象
