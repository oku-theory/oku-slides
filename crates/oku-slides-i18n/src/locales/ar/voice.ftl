# Spoken commands: comma-separated forms, matched whole, never with placeables.

voice-yes = نعم, أجل, أيوه, طبعا, حسنا, موافق, تمام, أكد, تأكيد, صحيح, اوكي
voice-no = لا, كلا, إلغاء, ألغ, ارفض, رفض
voice-negation = ليس, لن, لم, أبدا

voice-stop = توقف, قف, كفى, يكفي, اسكت, توقف عن الاستماع, كفى استماع
voice-ordinal-1 = الأول, الأولى, واحد, أول
voice-ordinal-2 = الثاني, الثانية, اثنان, اثنين
voice-ordinal-3 = الثالث, الثالثة, ثلاثة
voice-ordinal-4 = الرابع, الرابعة, أربعة
voice-ordinal-5 = الخامس, الخامسة, خمسة
voice-ordinal-6 = السادس, السادسة, ستة
voice-ordinal-7 = السابع, السابعة, سبعة
voice-ordinal-8 = الثامن, الثامنة, ثمانية
voice-ordinal-9 = التاسع, التاسعة, تسعة

voice-next = التالي, التالية, الشريحة التالية, للأمام, تقدم
voice-previous = السابق, السابقة, الشريحة السابقة, للخلف, ارجع, رجوع
voice-first = الشريحة الأولى, البداية, ابدأ من البداية, إلى البداية
voice-last = الشريحة الأخيرة, الأخيرة, الأخير, النهاية, إلى النهاية
voice-exit = اخرج, خروج, اخرج من العرض, الخروج من العرض, escape

voice-wake = oku, hey oku, أوكو, اوكو, يا أوكو, مرحبا أوكو
voice-filler = من فضلك, لو سمحت, شكرا, امم, اه, الان, يعني
voice-option = الخيار, خيار, رقم

voice-verb-replace = استبدل, استبدال, استبدله, اكتب فوقه, الكتابة فوق
voice-verb-merge = ادمج, دمج, دمجها, ادمجها
voice-verb-discard = تجاهل, تجاهلها, تخلص, ارمي
voice-verb-delete = احذف, حذف, احذفه, امسح, مسح
voice-verb-use-api = استخدم الواجهة, استخدم api, استخدام api, استخدام الواجهة
voice-verb-install = ثبت, تثبيت, حدث, تحديث
voice-verb-quit = أغلق التطبيق, إغلاق التطبيق, اخرج من التطبيق
voice-verb-close = أغلق, إغلاق, اغلق
voice-verb-import = استورد, استيراد

voice-say-question = { $question }
voice-say-option = الخيار { $n }: { $option }.
voice-say-confirm = للتأكيد، قل «{ $verb }»، أو قل لا.
voice-say-confirm-yes = للتأكيد، قل نعم، أو قل لا.
voice-say-permission = يطلب الوكيل إذنًا: قل نعم للسماح مرة واحدة، أو لا.
voice-say-agent-refused = رفض الوكيل الطلب.
voice-say-agent-stopped = توقف الوكيل.
voice-say-agent-no-start = تعذّر بدء تشغيل الوكيل.
voice-say-agent-no-tools = أدوات علامة التبويب هذه غير متاحة.
