# Spoken commands: comma-separated forms, matched whole, never with placeables.

voice-yes = да, ага, конечно, ок, окей, подтверждаю, подтвердить, верно, согласен, хорошо
voice-no = нет, неа, отмена, отменить, отказ
voice-negation = не, никогда, ни

voice-stop = стоп, стой, остановись, хватит, тихо, перестань слушать, хватит слушать
voice-ordinal-1 = первый, первая, первое, один, одна
voice-ordinal-2 = второй, вторая, второе, два, две
voice-ordinal-3 = третий, третья, третье, три
voice-ordinal-4 = четвёртый, четвёртая, четвёртое, четыре
voice-ordinal-5 = пятый, пятая, пятое, пять
voice-ordinal-6 = шестой, шестая, шестое, шесть
voice-ordinal-7 = седьмой, седьмая, седьмое, семь
voice-ordinal-8 = восьмой, восьмая, восьмое, восемь
voice-ordinal-9 = девятый, девятая, девятое, девять

voice-next = дальше, далее, следующий, следующая, следующий слайд, следующее, вперёд
voice-previous = назад, предыдущий, предыдущая, предыдущий слайд, вернись
voice-first = первый слайд, начало, в начало, к началу, в самое начало
voice-last = последний слайд, последний, последняя, конец, в конец, к концу
voice-exit = выход, выйти, выйди, выйти из презентации, выход из презентации, эскейп

voice-wake = oku, оку, эй оку, привет оку, ок оку
voice-filler = пожалуйста, спасибо, ну, эм, ээ, теперь, значит
voice-option = вариант, номер, пункт, опция

voice-verb-replace = заменить, замени, перезаписать, перезапиши
voice-verb-merge = объединить, объедини, слить, слей
voice-verb-discard = отбросить, отбрось, выбросить, выбрось, сбросить, сбрось
voice-verb-delete = удалить, удали, стереть, сотри
voice-verb-use-api = использовать API, используй API, использовать апи, используй апи, перейти на API
voice-verb-install = установить, установи, обновить, обнови
voice-verb-quit = выйти из приложения, закрыть приложение, закрой приложение
voice-verb-close = закрыть, закрой
voice-verb-import = импортировать, импортируй

voice-say-question = { $question }
voice-say-option = Вариант { $n }: { $option }.
voice-say-confirm = Чтобы подтвердить, скажите «{ $verb }» или скажите нет.
voice-say-confirm-yes = Чтобы подтвердить, скажите да или скажите нет.
voice-say-permission = Агент просит разрешения: скажите «да», чтобы разрешить один раз, или «нет».
voice-say-agent-refused = Агент отклонил запрос.
voice-say-agent-stopped = Агент остановился.
voice-say-agent-no-start = Не удалось запустить агента.
voice-say-agent-no-tools = Инструменты этой вкладки недоступны.
