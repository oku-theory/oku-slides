{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oku Slides",
  "version": "2.1.0",
  "identifier": "me.dartiguenave.oku-slides",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "bun install && bun run dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../ui"
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../assets/fonts/": "fonts/"
    },
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "Présentation Oku Slides",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExNDU3OUYzRkVBRTM3Q0IKUldUTE42Nys4M2xGRWM4clZrcnFNZjh0WmU1dWhSSk9kaWtmdUdZU0Z5WngzRjhCbTAvV3pLVHQK",
      "endpoints": [
        "https://github.com/oku-theory/oku-slides/releases/latest/download/latest.json"
      ]
    }
  }
}
