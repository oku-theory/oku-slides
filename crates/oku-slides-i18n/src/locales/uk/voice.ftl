# Spoken commands: comma-separated forms, matched whole, never with placeables.

voice-yes = так, угу, звичайно, ок, окей, підтверджую, підтвердити, правильно, згоден, добре
voice-no = ні, нє, скасувати, скасуй, відмова
voice-negation = не, ніколи, ані

voice-stop = стоп, стій, зупинись, досить, тихо, досить слухати, перестань слухати
voice-ordinal-1 = перший, перша, перше, один, одна
voice-ordinal-2 = другий, друга, друге, два, дві
voice-ordinal-3 = третій, третя, третє, три
voice-ordinal-4 = четвертий, четверта, четверте, чотири
voice-ordinal-5 = п'ятий, п'ята, п'яте, п'ять
voice-ordinal-6 = шостий, шоста, шосте, шість
voice-ordinal-7 = сьомий, сьома, сьоме, сім
voice-ordinal-8 = восьмий, восьма, восьме, вісім
voice-ordinal-9 = дев'ятий, дев'ята, дев'яте, дев'ять

voice-next = далі, наступний, наступна, наступний слайд, вперед
voice-previous = назад, попередній, попередня, попередній слайд, повернись
voice-first = перший слайд, початок, на початок, до початку
voice-last = останній слайд, останній, остання, кінець, в кінець, до кінця
voice-exit = вихід, вийти, вийди, вийти з презентації, вихід з презентації, ескейп

voice-wake = oku, оку, ей оку, привіт оку, ок оку
voice-filler = будь ласка, дякую, ну, ем, тепер, отже
voice-option = варіант, номер, пункт, опція

voice-verb-replace = замінити, заміни, перезаписати, перезапиши
voice-verb-merge = об'єднати, об'єднай, злити, злий
voice-verb-discard = відкинути, відкинь, викинути, викинь, скинути, скинь
voice-verb-delete = видалити, видали, стерти, зітри
voice-verb-use-api = використовувати API, використай API, використовуй API, використати API, використовувати апі, використай апі
voice-verb-install = встановити, встанови, оновити, онови
voice-verb-quit = вийти із застосунку, вийти з застосунку, закрити застосунок, закрий застосунок
voice-verb-close = закрити, закрий
voice-verb-import = імпортувати, імпортуй

voice-say-question = { $question }
voice-say-option = Варіант { $n }: { $option }.
voice-say-confirm = Щоб підтвердити, скажіть «{ $verb }» або скажіть ні.
voice-say-confirm-yes = Щоб підтвердити, скажіть так або скажіть ні.
voice-say-permission = Агент просить дозволу: скажіть «так», щоб дозволити один раз, або «ні».
voice-say-agent-refused = Агент відхилив запит.
voice-say-agent-stopped = Агент зупинився.
voice-say-agent-no-start = Не вдалося запустити агента.
voice-say-agent-no-tools = Інструменти цієї вкладки недоступні.
