# Spoken commands: comma-separated forms, matched whole, never with placeables.

voice-yes = हाँ, हां, जी, जी हाँ, ठीक है, ओके, ठीक, बिल्कुल, सही, पुष्टि करें, पुष्टि
voice-no = नहीं, ना, रद्द, रद्द करो, रद्द करें, मना
voice-negation = मत, कभी, न

voice-stop = रुको, रुक जाओ, बस, चुप, सुनना बंद करो, रुकिए
voice-ordinal-1 = पहला, पहली, एक
voice-ordinal-2 = दूसरा, दूसरी, दो
voice-ordinal-3 = तीसरा, तीसरी, तीन
voice-ordinal-4 = चौथा, चौथी, चार
voice-ordinal-5 = पाँचवाँ, पाँचवीं, पाँच, पांच
voice-ordinal-6 = छठा, छठी, छह, छः
voice-ordinal-7 = सातवाँ, सातवीं, सात
voice-ordinal-8 = आठवाँ, आठवीं, आठ
voice-ordinal-9 = नौवाँ, नौवीं, नौ

voice-next = अगला, अगली, अगली स्लाइड, आगे, आगे बढ़ो
voice-previous = पिछला, पिछली, पिछली स्लाइड, पीछे, वापस जाओ, पीछे जाओ
voice-first = पहली स्लाइड, शुरुआत, शुरू में, शुरुआत पर जाओ
voice-last = आखिरी स्लाइड, आखिरी, अंतिम स्लाइड, अंतिम, अंत में, अंत तक
voice-exit = बाहर निकलो, बाहर जाओ, प्रेजेंटेशन से बाहर निकलो, एस्केप

voice-wake = oku, hey oku, ओकु, ओकू, हे ओकु, सुनो ओकु
voice-filler = कृपया, प्लीज़, धन्यवाद, शुक्रिया, उम, अब, तो
voice-option = विकल्प, नंबर, क्रमांक

voice-verb-replace = बदलो, बदलें, बदल दो, ओवरराइट करो, ओवरराइट
voice-verb-merge = मिलाओ, मिला दो, विलय करो, मर्ज करो, मर्ज
voice-verb-discard = छोड़ दो, छोड़ो, फेंक दो, त्यागो
voice-verb-delete = हटाओ, हटा दो, मिटाओ, डिलीट करो, डिलीट
voice-verb-use-api = एपीआई इस्तेमाल करो, एपीआई का उपयोग करो, एपीआई उपयोग करो, api इस्तेमाल करो, api उपयोग करो
voice-verb-install = इंस्टॉल करो, इंस्टॉल, अपडेट करो, अपडेट
voice-verb-quit = ऐप बंद करो, ऐप से बाहर निकलो, एप्लिकेशन बंद करो
voice-verb-close = बंद करो, बंद करें
voice-verb-import = इम्पोर्ट करो, इम्पोर्ट, आयात करो, आयात

voice-say-question = { $question }
voice-say-option = विकल्प { $n }: { $option }।
voice-say-confirm = पुष्टि करने के लिए “{ $verb }” कहें, या नहीं कहें।
voice-say-confirm-yes = पुष्टि करने के लिए हाँ कहें, या नहीं कहें।
voice-say-confirm-action = { $action } के लिए हाँ कहें, या नहीं कहें।
voice-action-open = फ़ाइल खोलने
voice-action-save = प्रस्तुति सहेजने
voice-action-save-copy = एक कॉपी सहेजने
voice-action-move = प्रस्तुति को ले जाने
voice-action-new-deck = नई प्रस्तुति शुरू करने
voice-action-copy-pack = पैक कॉपी करने
voice-action-copy-theme = थीम कॉपी करने
voice-action-edit-theme = थीम बदलने
voice-action-change-setting = सेटिंग बदलने
voice-action-change-dictation = डिक्टेशन बदलने
voice-action-download = मॉडल डाउनलोड करने
voice-action-select-agent = एजेंट बदलने
voice-say-permission = एजेंट एक अनुमति माँग रहा है: एक बार अनुमति देने के लिए हाँ कहें, या नहीं।
voice-say-agent-refused = एजेंट ने अनुरोध अस्वीकार कर दिया।
voice-say-agent-stopped = एजेंट रुक गया।
voice-say-agent-no-start = एजेंट शुरू नहीं हो सका।
voice-say-agent-no-tools = इस टैब के टूल उपलब्ध नहीं हैं।
