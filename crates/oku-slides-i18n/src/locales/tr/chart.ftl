chart-invalid-option = geçersiz seçenekler: { $reason }
chart-patch-dataset = bir seçenek yaması `dataset` değerini değiştiremez: set_data kullanın
chart-patch-object = yama bir JSON nesnesi olmalı
chart-render = grafik çizilemedi
chart-data-no-row = { $row }. satır mevcut değil
chart-data-no-column = { $col }. sütun mevcut değil ({ $width } sütun)
chart-data-insert-row = { $at } konumuna satır eklenemez
chart-data-remove-row = { $at }. satır silinemez
chart-data-insert-column = { $at } konumuna sütun eklenemez
chart-data-too-many-cells = hücre sayısı satır sayısından fazla
chart-data-remove-column = { $at }. sütun silinemez
chart-data-keep-header = tablo başlık satırını korumalı
chart-no-series = en az bir seri gerekli
chart-dataset-header = dataset.source en azından başlık satırını içermeli
chart-unknown-column = “{ $name }” sütunu dataset içinde yok (sütunlar: { $columns })
chart-column-out-of-range = { $index }. sütun dataset dışında ({ $count } sütun)
chart-no-default-column = dataset içinde { $index }. sütun yok: `encode` belirtin
chart-category-data = dataset olmadan kategori ekseni `data` gerektirir
chart-mixed-series = { $kind } türünde bir seri çubuklar veya çizgilerle birleştirilemez
chart-horizontal-lines = yatay çizgiler desteklenmiyor
chart-series-numbers = { $index }. seri: veriler sayı olmalı
chart-series-empty = { $index }. serinin verisi yok
chart-single-series = { $kind } grafiğinde tam olarak bir seri bulunur
chart-pie-item = pie: her veri öğesi {"{"} name, value {"}"} olmalı
chart-pie-empty = verisiz pasta grafiği
chart-scatter-mixed = dağılım grafiği başka türlerle birleştirilemez
chart-scatter-point = { $index }. seri: her nokta [x, y] olmalı
chart-radar-indicators = dataset olmadan radar: `radar.indicator` gerekli
chart-radar-item = radar: her veri öğesi {"{"} name, value: [..] {"}"} olmalı
chart-radar-empty = verisiz radar grafiği
chart-radar-values = radar: “{ $name }” { $axes } eksen için { $values } değer içeriyor
chart-default-series = Seri { $n }
chart-default-category = Kategori
chart-default-value = Değer
chart-default-name = Ad
chart-default-axis = Eksen
chart-default-total = Toplam
chart-default-x = { $name } (x)
chart-patch-inline-data = dataset varken veriler dataset içinde kalmalı: set_data ile düzenleyin
chart-bad-color = geçersiz renk: { $color } (beklenen #rgb veya #rrggbb)
chart-waterfall-dataset = şelale grafiği verilerini yalnızca dataset'ten okur
chart-data-no-dataset = grafiğin veri tablosu (dataset) yok
chart-table-empty = tabloda en az bir satır ve bir sütun olmalı
chart-table-ragged = tablonun tüm satırlarında hücre sayısı aynı olmalı
chart-table-too-large = bir tabloda en fazla { $rows } satır ve { $columns } sütun olabilir
chart-table-cell-too-long = bir tablo hücresi en fazla { $max } karakter içerebilir
chart-table-not-finite = tablodaki sayılar sonlu olmalı
chart-table-align = align, tablonun sütun sayısından fazla girdi içeriyor ({ $width })
