chart-invalid-option = ungültige Optionen: { $reason }
chart-patch-dataset = ein Options-Patch kann `dataset` nicht ändern: set_data verwenden
chart-patch-object = der Patch muss ein JSON-Objekt sein
chart-render = das Diagramm konnte nicht gezeichnet werden
chart-data-no-row = Zeile { $row } existiert nicht
chart-data-no-column = Spalte { $col } existiert nicht ({ $width } Spalten)
chart-data-insert-row = an Position { $at } kann keine Zeile eingefügt werden
chart-data-remove-row = Zeile { $at } kann nicht entfernt werden
chart-data-insert-column = an Position { $at } kann keine Spalte eingefügt werden
chart-data-too-many-cells = mehr Zellen als Zeilen
chart-data-remove-column = Spalte { $at } kann nicht entfernt werden
chart-data-keep-header = die Tabelle muss ihre Kopfzeile behalten
chart-no-series = mindestens eine Reihe ist erforderlich
chart-dataset-header = dataset.source muss mindestens die Kopfzeile enthalten
chart-unknown-column = Spalte „{ $name }“ ist nicht im Dataset (Spalten: { $columns })
chart-column-out-of-range = Spalte { $index } liegt außerhalb des Datasets ({ $count } Spalten)
chart-no-default-column = keine Spalte { $index } im Dataset: `encode` angeben
chart-category-data = ohne Dataset braucht die Kategorieachse `data`
chart-mixed-series = eine Reihe vom Typ { $kind } kann nicht mit Balken oder Linien kombiniert werden
chart-horizontal-lines = Linien werden horizontal nicht unterstützt
chart-series-numbers = Reihe { $index }: Die Daten müssen Zahlen sein
chart-series-empty = Reihe { $index } hat keine Daten
chart-single-series = ein Diagramm vom Typ { $kind } hat genau eine Reihe
chart-pie-item = pie: Jedes Datenelement muss {"{"} name, value {"}"} sein
chart-pie-empty = Kreisdiagramm ohne Daten
chart-scatter-mixed = ein Streudiagramm kann nicht mit anderen Typen kombiniert werden
chart-scatter-point = Reihe { $index }: Jeder Punkt muss [x, y] sein
chart-radar-indicators = Radar ohne Dataset: `radar.indicator` ist erforderlich
chart-radar-item = radar: Jedes Datenelement muss {"{"} name, value: [..] {"}"} sein
chart-radar-empty = Radar ohne Daten
chart-radar-values = radar: „{ $name }“ hat { $values } Werte für { $axes } Achsen
chart-default-series = Reihe { $n }
chart-default-category = Kategorie
chart-default-value = Wert
chart-default-name = Name
chart-default-axis = Achse
chart-default-total = Summe
chart-default-x = { $name } (x)
chart-patch-inline-data = mit einem Dataset müssen die Daten im Dataset bleiben: mit set_data bearbeiten
chart-bad-color = ungültige Farbe: { $color } (erwartet: #rgb oder #rrggbb)
chart-waterfall-dataset = ein Wasserfalldiagramm liest seine Daten nur aus dataset
chart-data-no-dataset = das Diagramm hat keine Datentabelle (dataset)
chart-table-empty = die Tabelle braucht mindestens eine Zeile und eine Spalte
chart-table-ragged = alle Zeilen der Tabelle müssen gleich viele Zellen haben
chart-table-too-large = eine Tabelle hat höchstens { $rows } Zeilen und { $columns } Spalten
chart-table-cell-too-long = eine Tabellenzelle enthält höchstens { $max } Zeichen
chart-table-not-finite = Zahlen in der Tabelle müssen endlich sein
chart-table-align = align hat mehr Einträge als die Tabelle Spalten hat ({ $width })
