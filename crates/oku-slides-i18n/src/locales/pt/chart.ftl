chart-invalid-option = opções inválidas: { $reason }
chart-patch-dataset = um patch de opções não pode alterar `dataset`: use set_chart_data
chart-patch-object = o patch deve ser um objeto JSON
chart-render = não foi possível desenhar o gráfico
chart-data-no-row = a linha { $row } não existe
chart-data-no-column = a coluna { $col } não existe ({ $width } colunas)
chart-data-insert-row = não é possível inserir uma linha em { $at }
chart-data-remove-row = não é possível remover a linha { $at }
chart-data-insert-column = não é possível inserir uma coluna em { $at }
chart-data-too-many-cells = mais células do que linhas
chart-data-remove-column = não é possível remover a coluna { $at }
chart-data-keep-header = a tabela deve manter a linha de cabeçalho
chart-no-series = é necessária pelo menos uma série
chart-dataset-header = dataset.source deve conter pelo menos a linha de cabeçalho
chart-unknown-column = a coluna “{ $name }” não está no dataset (colunas: { $columns })
chart-column-out-of-range = a coluna { $index } está fora do dataset ({ $count } colunas)
chart-no-default-column = não há coluna { $index } no dataset: especifique `encode`
chart-category-data = sem dataset, o eixo de categorias precisa de `data`
chart-mixed-series = uma série { $kind } não pode ser combinada com barras ou linhas
chart-horizontal-lines = linhas não são suportadas na horizontal
chart-series-numbers = série { $index }: os dados devem ser números
chart-series-empty = a série { $index } não tem dados
chart-single-series = um gráfico { $kind } tem exatamente uma série
chart-pie-item = pie: cada item de dados deve ser {"{"} name, value {"}"}
chart-pie-empty = gráfico de pizza sem dados
chart-scatter-mixed = um gráfico de dispersão não pode ser combinado com outros tipos
chart-scatter-point = série { $index }: cada ponto deve ser [x, y]
chart-radar-indicators = radar sem dataset: `radar.indicator` é obrigatório
chart-radar-item = radar: cada item de dados deve ser {"{"} name, value: [..] {"}"}
chart-radar-empty = radar sem dados
chart-radar-values = radar: “{ $name }” tem { $values } valores para { $axes } eixos
chart-default-series = Série { $n }
chart-default-category = Categoria
chart-default-value = Valor
chart-default-name = Nome
chart-default-axis = Eixo
chart-default-x = { $name } (x)
chart-patch-inline-data = com um dataset, os dados devem ficar no dataset: edite-os com set_chart_data
chart-bad-color = cor inválida: { $color } (esperado #rgb ou #rrggbb)
