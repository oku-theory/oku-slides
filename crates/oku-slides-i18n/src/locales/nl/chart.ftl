chart-invalid-option = ongeldige opties: { $reason }
chart-patch-dataset = een optiepatch kan `dataset` niet wijzigen: gebruik edit_data
chart-patch-object = de patch moet een JSON-object zijn
chart-render = de grafiek kon niet worden getekend
chart-ids-length = dataset.ids heeft één id per rij nodig en dataset.columns één per kolom
chart-ids-duplicate = een rij- of kolom-id komt dubbel voor
chart-ids-invalid = een rij- of kolom-id heeft 1 tot 64 letters, cijfers, - of _
chart-no-series = er is minstens één reeks nodig
chart-unknown-column = kolom ‘{ $name }’ staat niet in de dataset (kolommen: { $columns })
chart-column-out-of-range = kolom { $index } valt buiten de dataset ({ $count } kolommen)
chart-no-default-column = geen kolom { $index } in de dataset: geef `encode` op
chart-category-data = zonder dataset heeft de categorie-as `data` nodig
chart-mixed-series = een reeks van het type { $kind } kan niet worden gecombineerd met staven of lijnen
chart-horizontal-lines = lijnen worden horizontaal niet ondersteund
chart-series-numbers = reeks { $index }: de gegevens moeten getallen zijn
chart-series-empty = reeks { $index } heeft geen gegevens
chart-single-series = een grafiek van het type { $kind } heeft precies één reeks
chart-pie-item = pie: elk gegevensitem moet {"{"} name, value {"}"} zijn
chart-pie-empty = cirkeldiagram zonder gegevens
chart-scatter-mixed = een spreidingsdiagram kan niet worden gecombineerd met andere typen
chart-scatter-point = reeks { $index }: elk punt moet [x, y] zijn
chart-radar-indicators = radar zonder dataset: `radar.indicator` is verplicht
chart-radar-item = radar: elk gegevensitem moet {"{"} name, value: [..] {"}"} zijn
chart-radar-empty = radar zonder gegevens
chart-radar-values = radar: ‘{ $name }’ heeft { $values } waarden voor { $axes } assen
chart-default-series = Reeks { $n }
chart-default-category = Categorie
chart-default-value = Waarde
chart-default-name = Naam
chart-default-axis = As
chart-default-total = Totaal
chart-default-x = { $name } (x)
chart-patch-inline-data = met een dataset moeten de gegevens in de dataset blijven: bewerk ze met edit_data
chart-bad-color = ongeldige kleur: { $color } (verwacht #rgb of #rrggbb)
chart-waterfall-dataset = een watervalgrafiek leest zijn gegevens alleen uit dataset
chart-no-dataset = de grafiek heeft geen gegevenstabel (dataset)
chart-table-empty = de tabel heeft minstens één rij en één kolom nodig
chart-table-ragged = alle rijen van de tabel moeten evenveel cellen hebben
chart-table-too-large = een tabel heeft hoogstens { $rows } rijen en { $columns } kolommen
chart-table-cell-too-long = een tabelcel bevat hoogstens { $max } tekens
chart-table-not-finite = getallen in de tabel moeten eindig zijn
chart-table-chart-option = chart moet een object met grafiekopties zijn
chart-table-chart-columns = chart-columns moet geldige, onderling verschillende kolom-id's bevatten (1 tot 64 letters, cijfers, - of _)
chart-table-geometry = column-widths en row-heights geven één eindig, positief gewicht per kolom of rij
chart-axis-interval = het interval (interval) van een as moet een getal groter dan 0 zijn
chart-axis-bounds = het maximum (max) van een as moet groter zijn dan het minimum (min)
chart-bar-gap = barCategoryGap hoort alleen bij een staafreeks: een percentage van 0% tot onder 100%, of een lengte in punten van 0 of meer
chart-ref-and-inline = een optie kan niet zowel een gegevensverwijzing als ingesloten gegevens bevatten: houd er één
chart-ref-null = `data` mag niet null zijn: verwijder in plaats daarvan de sleutel
chart-columns-invalid = `columns` vereist `data` en noemt 1 tot 64 geldige, verschillende kolom-id's
