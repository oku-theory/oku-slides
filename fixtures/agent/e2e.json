        { "tool": "report", "args": { "title": "Choix noté", "facts": ["la réponse sera suivie"] } }
      ]
    },
    {
      "tool_calls": [{ "id": "t5", "title": "Lire la slide" }, { "id": "t6", "title": "Changer le fond" }],
      "mcp": [
        { "tool": "report", "args": { "title": "Fond bleu nuit", "facts": ["titre en blanc"], "slide": "s-libre", "actions": [{ "label": "Autre couleur" }] } }
      ]
    },
    {
      "tool_calls": [{ "id": "t7", "title": "Lire le thème" }],
      "mcp": [
        { "tool": "ask_choice", "args": { "question": "Quelle couleur ?", "options": [
          { "id": "n", "label": "Nuit" }, { "id": "s", "label": "Sable" }
        ] } },
        { "tool": "report", "args": { "title": "Couleur retenue", "facts": ["le fond suivra"] } }
      ]
    },
    {
      "parallel": true,
      "tool_calls": [{ "id": "t8", "title": "Lire le titre" }, { "id": "t9", "title": "Lire la police" }],
      "mcp": [
        { "tool": "ask_choice", "args": { "question": "Quel titre ?", "options": [
          { "id": "c", "label": "Court" }, { "id": "l", "label": "Long" }
        ] } },
        { "tool": "ask_choice", "args": { "question": "Quelle police ?", "options": [
          { "id": "s", "label": "Serif" }, { "id": "g", "label": "Grotesque" }
        ] } }
      ]
    }
  ],
  "sessions": {
    "2": [
      {
        "tool_calls": [{ "id": "t1", "title": "Lire la slide" }],
