chart-invalid-option = অবৈধ অপশন: { $reason }
chart-patch-dataset = অপশন প্যাচ `dataset` পরিবর্তন করতে পারে না: set_data ব্যবহার করুন
chart-patch-object = প্যাচটি অবশ্যই একটি JSON অবজেক্ট হতে হবে
chart-render = চার্ট আঁকা যায়নি
chart-data-no-row = সারি { $row } নেই
chart-data-no-column = কলাম { $col } নেই ({ $width }টি কলাম)
chart-data-insert-row = { $at } অবস্থানে সারি যোগ করা যাবে না
chart-data-remove-row = সারি { $at } মোছা যাবে না
chart-data-insert-column = { $at } অবস্থানে কলাম যোগ করা যাবে না
chart-data-too-many-cells = সারির চেয়ে বেশি ঘর
chart-data-remove-column = কলাম { $at } মোছা যাবে না
chart-data-keep-header = টেবিলে হেডার সারি রাখতেই হবে
chart-no-series = অন্তত একটি সিরিজ প্রয়োজন
chart-dataset-header = dataset.source-এ অন্তত হেডার সারিটি থাকতে হবে
chart-unknown-column = কলাম “{ $name }” dataset-এ নেই (কলাম: { $columns })
chart-column-out-of-range = কলাম { $index } dataset-এর বাইরে ({ $count }টি কলাম)
chart-no-default-column = dataset-এ কলাম { $index } নেই: `encode` নির্দিষ্ট করুন
chart-category-data = dataset ছাড়া ক্যাটাগরি অক্ষের `data` প্রয়োজন
chart-mixed-series = { $kind } সিরিজ বার বা লাইনের সঙ্গে মেশানো যায় না
chart-horizontal-lines = অনুভূমিকভাবে লাইন সমর্থিত নয়
chart-series-numbers = সিরিজ { $index }: ডেটা অবশ্যই সংখ্যা হতে হবে
chart-series-empty = সিরিজ { $index }-এ কোনো ডেটা নেই
chart-single-series = { $kind } চার্টে ঠিক একটি সিরিজ থাকে
chart-pie-item = pie: প্রতিটি ডেটা আইটেম অবশ্যই {"{"} name, value {"}"} হতে হবে
chart-pie-empty = ডেটা ছাড়া পাই চার্ট
chart-scatter-mixed = স্ক্যাটার প্লট অন্য ধরনের সঙ্গে মেশানো যায় না
chart-scatter-point = সিরিজ { $index }: প্রতিটি বিন্দু অবশ্যই [x, y] হতে হবে
chart-radar-indicators = dataset ছাড়া radar: `radar.indicator` প্রয়োজন
chart-radar-item = radar: প্রতিটি ডেটা আইটেম অবশ্যই {"{"} name, value: [..] {"}"} হতে হবে
chart-radar-empty = ডেটা ছাড়া রাডার
chart-radar-values = radar: “{ $name }”-এ { $axes }টি অক্ষের জন্য { $values }টি মান আছে
chart-default-series = সিরিজ { $n }
chart-default-category = ক্যাটাগরি
chart-default-value = মান
chart-default-name = নাম
chart-default-axis = অক্ষ
chart-default-total = মোট
chart-default-x = { $name } (x)
chart-patch-inline-data = dataset থাকলে ডেটা dataset-এই থাকতে হবে: set_data দিয়ে সম্পাদনা করুন
chart-bad-color = অবৈধ রং: { $color } (প্রত্যাশিত #rgb বা #rrggbb)
chart-waterfall-dataset = ওয়াটারফল চার্ট শুধু dataset থেকে ডেটা পড়ে
chart-data-no-dataset = চার্টে কোনো ডেটা টেবিল (dataset) নেই
chart-table-empty = টেবিলে অন্তত একটি সারি ও একটি কলাম থাকতে হবে
chart-table-ragged = টেবিলের প্রতিটি সারিতে ঘরের সংখ্যা সমান হতে হবে
chart-table-too-large = একটি টেবিলে সর্বোচ্চ { $rows } সারি ও { $columns } কলাম থাকতে পারে
chart-table-cell-too-long = টেবিলের একটি ঘরে সর্বোচ্চ { $max } অক্ষর থাকতে পারে
chart-table-not-finite = টেবিলের সংখ্যাগুলো সসীম হতে হবে
chart-table-align = align-এ টেবিলের কলাম সংখ্যার ({ $width }) চেয়ে বেশি এন্ট্রি আছে
