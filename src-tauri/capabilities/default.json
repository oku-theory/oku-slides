{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Workspace windows (w-<n>): every app command, events, dialogs, fullscreen (presenting). The agent window has its own (agent.json).",
  "windows": ["w-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-background-color",
    "core:window:allow-set-focus",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-theme",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "allow-request",
    "allow-workspace",
    "allow-drag-tab-over",
    "allow-drag-tab-leave",
    "allow-drop-tab",
    "allow-quit",
    "allow-quit-ready",
    "allow-stt",
    "allow-agent",
    "allow-agent-link",
    "allow-take-close-decision",
    "allow-update-status",
    "allow-check-update",
    "allow-install-update",
    "allow-open-release-page",
    "allow-later-update",
    "allow-take-update-notice"
  ]
}
