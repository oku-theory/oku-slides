chart-invalid-option = opciones no válidas: { $reason }
chart-patch-dataset = un parche de opciones no puede cambiar `dataset`: usa set_data
chart-patch-object = el parche debe ser un objeto JSON
chart-render = no se pudo dibujar el gráfico
chart-data-no-row = la fila { $row } no existe
chart-data-no-column = la columna { $col } no existe ({ $width } columnas)
chart-data-insert-row = no se puede insertar una fila en { $at }
chart-data-remove-row = no se puede eliminar la fila { $at }
chart-data-insert-column = no se puede insertar una columna en { $at }
chart-data-too-many-cells = más celdas que filas
chart-data-remove-column = no se puede eliminar la columna { $at }
chart-data-keep-header = la tabla debe conservar su fila de encabezado
chart-data-ids-length = dataset.ids necesita un id por fila y dataset.columns uno por columna
chart-data-ids-duplicate = un id de fila o de columna está repetido
chart-data-ids-invalid = un id de fila o de columna tiene de 1 a 64 letras, cifras, - o _
chart-data-id-taken = este id de fila o de columna ya está en uso
chart-no-series = se necesita al menos una serie
chart-dataset-header = dataset.source debe contener al menos la fila de encabezado
chart-unknown-column = la columna «{ $name }» no está en el dataset (columnas: { $columns })
chart-column-out-of-range = la columna { $index } está fuera del dataset ({ $count } columnas)
chart-no-default-column = no hay columna { $index } en el dataset: especifica `encode`
chart-category-data = sin dataset, el eje de categorías necesita `data`
chart-mixed-series = una serie { $kind } no se puede combinar con barras ni líneas
chart-horizontal-lines = las líneas no se admiten en horizontal
chart-series-numbers = serie { $index }: los datos deben ser números
chart-series-empty = la serie { $index } no tiene datos
chart-single-series = un gráfico { $kind } tiene exactamente una serie
chart-pie-item = pie: cada elemento de datos debe ser {"{"} name, value {"}"}
chart-pie-empty = gráfico circular sin datos
chart-scatter-mixed = un gráfico de dispersión no se puede combinar con otros tipos
chart-scatter-point = serie { $index }: cada punto debe ser [x, y]
chart-radar-indicators = radar sin dataset: se requiere `radar.indicator`
chart-radar-item = radar: cada elemento de datos debe ser {"{"} name, value: [..] {"}"}
chart-radar-empty = radar sin datos
chart-radar-values = radar: «{ $name }» tiene { $values } valores para { $axes } ejes
chart-default-series = Serie { $n }
chart-default-category = Categoría
chart-default-value = Valor
chart-default-name = Nombre
chart-default-axis = Eje
chart-default-total = Total
chart-default-x = { $name } (x)
chart-patch-inline-data = con un dataset, los datos deben quedarse en el dataset: edítalos con set_data
chart-bad-color = color no válido: { $color } (se espera #rgb o #rrggbb)
chart-waterfall-dataset = un gráfico de cascada solo lee sus datos de dataset
chart-data-no-dataset = el gráfico no tiene tabla de datos (dataset)
chart-table-empty = la tabla necesita al menos una fila y una columna
chart-table-ragged = todas las filas de la tabla deben tener el mismo número de celdas
chart-table-too-large = una tabla tiene como máximo { $rows } filas y { $columns } columnas
chart-table-cell-too-long = una celda de la tabla contiene como máximo { $max } caracteres
chart-table-not-finite = los números de la tabla deben ser finitos
chart-table-chart-option = chart debe ser un objeto de opciones de gráfico
chart-table-chart-columns = chart-columns debe enumerar identificadores de columna válidos (de 1 a 64 letras, cifras, - o _)
