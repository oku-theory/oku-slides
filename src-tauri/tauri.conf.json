{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slider",
  "version": "0.1.0",
  "identifier": "me.dartiguenave.slider",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "bun install && bun run dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "bun run build", "cwd": "../ui" }
  },
  "app": {
    "windows": [
      {
        "title": "Slider",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "resources": { "../assets/fonts/": "fonts/" },
    "fileAssociations": [
      { "ext": ["pdf"], "name": "Présentation Slider", "role": "Editor", "mimeType": "application/pdf" }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
