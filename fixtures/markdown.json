{
  "_comment": "Aller-retour paragraphes ↔ markdown d'édition : paragraphs_to_text (Rust) écrit `markdown`, textToParagraphs (TS) le relit en `paragraphs`. `lossy` : perte documentée des bords, relue en `reread`.",
  "cases": [
    {
      "name": "texte simple",
      "markdown": "Bonjour",
      "paragraphs": [
        {
          "runs": [
            {
              "t": "Bonjour"
            }
          ]
        }
      ]
    },
    {
      "name": "gras, italique et les deux",
      "markdown": "a **gras** *italique* ***les deux***",
      "paragraphs": [
        {
          "runs": [
            {
              "t": "a "
            },
            {
              "t": "gras",
              "bold": true
            },
            {
              "t": " "
            },
            {
              "t": "italique",
              "italic": true
            },
            {
              "t": " "
            },
            {
              "t": "les deux",
              "bold": true,
              "italic": true
            }
          ]
        }
      ]
    },
    {
      "name": "lien simple et lien en gras",
      "markdown": "voir [le site](https://oku.dev/a) ou [**ici**](mailto:a@b.c)",
      "paragraphs": [
        {
          "runs": [
            {
              "t": "voir "
            },
            {
              "t": "le site",
              "link": "https://oku.dev/a"
            },
            {
              "t": " ou "
            },
            {
              "t": "ici",
              "bold": true,
              "link": "mailto:a@b.c"
            }
          ]
        }
      ]
    },
    {
      "name": "puces et liste numérotée",
      "markdown": "Titre\n- **Point**\n1. un\n2. deux",
      "paragraphs": [
        {
          "runs": [
            {
              "t": "Titre"
            }
          ]
        },
        {
          "runs": [
            {
              "t": "Point",
              "bold": true
            }
          ],
          "list": "bullet"
        },
        {
          "runs": [
            {
              "t": "un"
            }
          ],
          "list": "number"
        },
        {
          "runs": [
            {
              "t": "deux"
            }
          ],
          "list": "number"
        }
      ]
    },
    {
      "name": "liste numérotée reprise à 1 après un paragraphe ou une puce",
      "markdown": "1. un\n2. deux\nEntre\n1. trois\n- puce\n1. quatre",
      "paragraphs": [
        {
          "runs": [
            {
              "t": "un"
            }
          ],
          "list": "number"
        },
        {
          "runs": [
            {
              "t": "deux"
            }
          ],
          "list": "number"
        },
        {
          "runs": [
            {
              "t": "Entre"
            }
          ]
        },
        {
          "runs": [
            {
              "t": "trois"
            }
          ],
          "list": "number"
        },
        {
          "runs": [
            {
              "t": "puce"
            }
          ],
          "list": "bullet"
        },
        {
          "runs": [
            {
              "t": "quatre"
            }
          ],
          "list": "number"
        }
      ]
    },
    {
      "name": "caractères spéciaux échappés",
      "markdown": "2 \\* 3 \\[note\\] a\\\\b \\_x\\_ snake_case",
      "paragraphs": [
        {
          "runs": [
            {
              "t": "2 * 3 [note] a\\b _x_ snake_case"
            }
          ]
        }
      ]
    },
    {
      "name": "texte qui ressemble à une liste",
      "markdown": "\\- pas une puce\n1\\. pas un numéro",
      "paragraphs": [
        {
          "runs": [
            {
              "t": "- pas une puce"
            }
          ]
        },
        {
          "runs": [
            {
              "t": "1. pas un numéro"
            }
          ]
        }
      ]
    },
    {
      "name": "adresse déjà encodée gardée telle quelle",
      "markdown": "[wiki](https://w.org/A_%28b%29%20c)",
      "paragraphs": [
        {
          "runs": [
            {
              "t": "wiki",
              "link": "https://w.org/A_%28b%29%20c"
            }
          ]
        }
      ]
    },
    {
      "name": "pastilles de couleur",
      "markdown": "==上手=={2} ==に=={5} ==なる==",
      "paragraphs": [
        {
          "runs": [
            {
              "t": "上手",
              "highlight": 2
            },
            {
              "t": " "
            },
            {
              "t": "に",
              "highlight": 5
            },
            {
              "t": " "
            },
            {
              "t": "なる",
              "highlight": 1
            }
          ]
        }
      ]
    },
    {
      "name": "pastille en gras dans un lien",
      "markdown": "[==**x**=={3}](https://a.b)",
      "paragraphs": [
        {
          "runs": [
            {
              "t": "x",
              "bold": true,
              "highlight": 3,
              "link": "https://a.b"
            }
          ]
        }
      ]
    },
    {
      "name": "signes égal et accolades échappés",
      "markdown": "a \\=\\= b, x=y ==a==\\{2} et {{nom}}",
      "paragraphs": [
        {
          "runs": [
            {
              "t": "a == b, x=y "
            },
            {
              "t": "a",
              "highlight": 1
            },
            {
              "t": "{2} et {{nom}}"
            }
          ]
        }
      ]
    },
    {
      "name": "pastilles voisines",
      "markdown": "==a=={1}==b=={2}",
      "paragraphs": [
        {
          "runs": [
            {
              "t": "a",
              "highlight": 1
            },
            {
              "t": "b",
              "highlight": 2
            }
          ]
        }
      ]
    },
    {
      "name": "texte qui ressemble à de la mise en forme",
      "markdown": "a \\*b\\* c \\[x\\](y)",
      "paragraphs": [{ "runs": [{ "t": "a *b* c [x](y)" }] }]
    },
    {
      "name": "texte externe littéral (t-162)",
      "markdown": "2 \\* 3 \\* 4, \\[1\\](x), \\=\\=x\\=\\=, x = y, Ⓐ\\_Ⓑ, snake_case, C:\\\\dir\nfin \\=",
      "paragraphs": [{ "runs": [{ "t": "2 * 3 * 4, [1](x), ==x==, x = y, Ⓐ_Ⓑ, snake_case, C:\\dir" }] }, { "runs": [{ "t": "fin =" }] }]
    },
    {
      "name": "titre et citation en début de ligne",
      "markdown": "# pas un titre\n> pas une citation",
      "paragraphs": [{ "runs": [{ "t": "# pas un titre" }] }, { "runs": [{ "t": "> pas une citation" }] }]
    },
    {
      "name": "ponctuation française",
      "markdown": "Bonjour ! Ça va ?",
      "paragraphs": [{ "runs": [{ "t": "Bonjour ! Ça va ?" }] }]
    },
    {
      "name": "pastille réduite à un égal",
      "markdown": "==\\===",
      "paragraphs": [{ "runs": [{ "t": "=", "highlight": 1 }] }]
    },
    {
      "name": "italique puis gras collés",
      "markdown": "*a***b**",
      "paragraphs": [{ "runs": [{ "t": "a", "italic": true }, { "t": "b", "bold": true }] }]
    },
    {
      "name": "gras puis italique collés",
      "markdown": "**a***b*",
      "paragraphs": [{ "runs": [{ "t": "a", "bold": true }, { "t": "b", "italic": true }] }]
    },
    {
      "name": "gras-italique puis italique",
      "markdown": "***X**Y*",
      "paragraphs": [{ "runs": [{ "t": "X", "bold": true, "italic": true }, { "t": "Y", "italic": true }] }]
    },
    {
      "name": "pastille en gras collée à du japonais",
      "markdown": "上==**a**=={2}です",
      "paragraphs": [{ "runs": [{ "t": "上" }, { "t": "a", "bold": true, "highlight": 2 }, { "t": "です" }] }]
    }
  ],
  "lossy": [
    {
      "name": "espaces en bord de gras",
      "paragraphs": [{ "runs": [{ "t": "a" }, { "t": " x ", "bold": true }, { "t": "b" }] }],
      "markdown": "a **x** b",
      "reread": [{ "runs": [{ "t": "a " }, { "t": "x", "bold": true }, { "t": " b" }] }]
    },
    {
      "name": "ponctuation collée à une lettre",
      "paragraphs": [{ "runs": [{ "t": "a" }, { "t": "\"x\"", "italic": true }, { "t": "b" }] }],
      "markdown": "a\"*x*\"b",
      "reread": [{ "runs": [{ "t": "a\"" }, { "t": "x", "italic": true }, { "t": "\"b" }] }]
    },
    {
      "name": "pastille réduite à une espace",
      "paragraphs": [{ "runs": [{ "t": "a" }, { "t": " ", "highlight": 2 }, { "t": "b" }] }],
      "markdown": "a b",
      "reread": [{ "runs": [{ "t": "a b" }] }]
    },
    {
      "name": "gras sur un tiret collé à de l'italique",
      "paragraphs": [{ "runs": [{ "t": "-", "bold": true }, { "t": "a", "italic": true }] }],
      "markdown": "-*a*",
      "reread": [{ "runs": [{ "t": "-" }, { "t": "a", "italic": true }] }]
    },
    {
      "name": "adresse commençant par un chevron",
      "paragraphs": [{ "runs": [{ "t": "a", "link": "<x" }] }],
      "markdown": "[a](%3Cx)",
      "reread": [{ "runs": [{ "t": "a", "link": "%3Cx" }] }]
    },
    {
      "name": "adresse finissant par une barre oblique inverse",
      "paragraphs": [{ "runs": [{ "t": "a", "link": "x\\" }] }],
      "markdown": "[a](x%5C)",
      "reread": [{ "runs": [{ "t": "a", "link": "x%5C" }] }]
    },
    {
      "name": "chevron au milieu de l'adresse : exact",
      "paragraphs": [{ "runs": [{ "t": "a", "link": "https://a.b/?q=<x>" }] }],
      "markdown": "[a](https://a.b/?q=<x>)",
      "reread": [{ "runs": [{ "t": "a", "link": "https://a.b/?q=<x>" }] }]
    }
  ]
}
