data-cell-type = قيمة لا تناسب العمود «{ $column }» الذي يحتوي على { $type ->
    [number] أرقام
    [integer] أعداد صحيحة
    [bool] صواب أو خطأ
    [date] تواريخ (YYYY-MM-DD)
   *[text] نص لا يتجاوز 16 KB
}
data-column-type = لا يمكن تحويل العمود «{ $column }» إلى { $type ->
    [number] عمود أرقام
    [integer] عمود أعداد صحيحة
    [bool] عمود صواب/خطأ
    [date] عمود تواريخ
   *[text] عمود نص
} دون فقدان، راجع الصفوف { $rows }{ $more ->
    [0] {""}
   *[other] {" "}وغيرها (العدد: { $more })
}
data-no-row = الصف { $row } غير موجود
data-no-column = العمود { $column } غير موجود
data-id-taken = المعرّف { $id } مستخدم بالفعل في هذا الجدول
data-id-invalid = المعرّف «{ $id }» غير صالح: استخدم من 1 إلى 64 حرفًا لاتينيًا أو رقمًا أو - أو _
data-id-missing = صف أو عمود أو جدول جديد بلا معرّف
data-too-large = { $what ->
    [rows] ستتجاوز البيانات حدّ الصفوف (الحد: { $max })
    [columns] ستتجاوز البيانات حدّ الأعمدة (الحد: { $max })
    [text] ستتجاوز خلية نصية حدّها بالبايت (الحد: { $max })
   *[overlay] ستتجاوز البيانات حدّ الخلايا المعدّلة (الحد: { $max })
}
data-invalid-name = «{ $name }» ليس اسم بيانات صالحًا: استخدم أحرفًا لاتينية صغيرة وأرقامًا و_ دون البدء برقم
data-non-finite = أرقام غير منتهية (NaN أو لانهاية)، العدد: { $count }
data-columns-invalid = قائمة الأعمدة فارغة أو تذكر عمودًا مرتين
data-row-width = يحتوي صف على خلايا أكثر من أعمدة الجدول (العدد: { $max })
data-needs-base = تحفظ هذه البيانات صفوفها في ملف أساسي لا يستطيع هذا التعديل قراءته بعد
data-base-row-cells = الجدول الذي له ملف أساسي يعطي معرّفات صفوفه فقط، دون خلايا
data-row-cut = صفوف فيها خلايا أكثر من الترويسة، وحُذفت الخلايا الزائدة، العدد: { $count }
data-base-invalid = الملف الأساسي للبيانات تالف أو لا يطابق جدولها
