chart-invalid-option = tùy chọn không hợp lệ: { $reason }
chart-patch-dataset = bản vá tùy chọn không thể thay đổi `dataset`: hãy dùng set_chart_data
chart-patch-object = bản vá phải là một đối tượng JSON
chart-render = không thể vẽ biểu đồ
chart-data-no-row = hàng { $row } không tồn tại
chart-data-no-column = cột { $col } không tồn tại ({ $width } cột)
chart-data-insert-row = không thể chèn hàng tại { $at }
chart-data-remove-row = không thể xóa hàng { $at }
chart-data-insert-column = không thể chèn cột tại { $at }
chart-data-too-many-cells = số ô nhiều hơn số hàng
chart-data-remove-column = không thể xóa cột { $at }
chart-data-keep-header = bảng phải giữ hàng tiêu đề
chart-no-series = cần ít nhất một chuỗi dữ liệu
chart-dataset-header = dataset.source phải chứa ít nhất hàng tiêu đề
chart-unknown-column = cột “{ $name }” không có trong dataset (các cột: { $columns })
chart-column-out-of-range = cột { $index } nằm ngoài dataset ({ $count } cột)
chart-no-default-column = không có cột { $index } trong dataset: hãy chỉ định `encode`
chart-category-data = khi không có dataset, trục danh mục cần `data`
chart-mixed-series = chuỗi { $kind } không thể kết hợp với cột hoặc đường
chart-horizontal-lines = không hỗ trợ đường theo chiều ngang
chart-series-numbers = chuỗi { $index }: dữ liệu phải là số
chart-series-empty = chuỗi { $index } không có dữ liệu
chart-single-series = biểu đồ { $kind } chỉ có đúng một chuỗi
chart-pie-item = tròn: mỗi mục dữ liệu phải là {"{"} name, value {"}"}
chart-pie-empty = biểu đồ tròn không có dữ liệu
chart-scatter-mixed = biểu đồ phân tán không thể kết hợp với loại khác
chart-scatter-point = chuỗi { $index }: mỗi điểm phải là [x, y]
chart-radar-indicators = radar không có dataset: cần có `radar.indicator`
chart-radar-item = radar: mỗi mục dữ liệu phải là {"{"} name, value: [..] {"}"}
chart-radar-empty = radar không có dữ liệu
chart-radar-values = radar: “{ $name }” có { $values } giá trị cho { $axes } trục
chart-default-series = Chuỗi { $n }
chart-default-category = Danh mục
chart-default-value = Giá trị
chart-default-name = Tên
chart-default-axis = Trục
chart-default-total = Tổng
chart-default-x = { $name } (x)
chart-patch-inline-data = khi có dataset, dữ liệu phải nằm trong dataset: hãy sửa bằng set_chart_data
chart-bad-color = màu không hợp lệ: { $color } (cần #rgb hoặc #rrggbb)
chart-waterfall-dataset = biểu đồ thác nước chỉ đọc dữ liệu từ dataset
