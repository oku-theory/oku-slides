chart-invalid-option = invalid options: { $reason }
chart-patch-dataset = an option patch cannot change `dataset`: use edit_data
chart-patch-object = the patch must be a JSON object
chart-render = the chart could not be drawn
chart-ids-length = dataset.ids needs one id per row and dataset.columns one per column
chart-ids-duplicate = a row or column id is repeated
chart-ids-invalid = a row or column id has 1 to 64 letters, digits, - or _
chart-no-series = at least one series is required
chart-unknown-column = column “{ $name }” is not in the dataset (columns: { $columns })
chart-column-out-of-range = column { $index } is outside the dataset ({ $count } columns)
chart-no-default-column = no column { $index } in the dataset: specify `encode`
chart-category-data = without a dataset, the category axis needs `data`
chart-mixed-series = a { $kind } series cannot be combined with bars or lines
chart-horizontal-lines = lines are not supported horizontally
chart-series-numbers = series { $index }: data must be numbers
chart-series-empty = series { $index } has no data
chart-single-series = a { $kind } chart has exactly one series
chart-pie-item = pie: each data item must be {"{"} name, value {"}"}
chart-pie-empty = pie chart without data
chart-scatter-mixed = a scatter plot cannot be combined with other types
chart-scatter-point = series { $index }: each point must be [x, y]
chart-radar-indicators = radar without a dataset: `radar.indicator` is required
chart-radar-item = radar: each data item must be {"{"} name, value: [..] {"}"}
chart-radar-empty = radar without data
chart-radar-values = radar: “{ $name }” has { $values } values for { $axes } axes
chart-default-series = Series { $n }
chart-default-category = Category
chart-default-value = Value
chart-default-name = Name
chart-default-axis = Axis
chart-default-total = Total
chart-default-x = { $name } (x)
chart-patch-inline-data = with a dataset, data must stay in the dataset: edit it with edit_data
chart-bad-color = invalid color: { $color } (expected #rgb or #rrggbb)
chart-waterfall-dataset = a waterfall chart reads its data from dataset only
chart-no-dataset = the chart has no data table (dataset)
chart-table-empty = the table needs at least one row and one column
chart-table-ragged = every row of the table must have the same number of cells
chart-table-too-large = a table has at most { $rows } rows and { $columns } columns
chart-table-cell-too-long = a table cell holds at most { $max } characters
chart-table-not-finite = table numbers must be finite
chart-table-chart-option = chart must be a chart option object
chart-table-chart-columns = chart-columns must list valid, distinct column identifiers (1 to 64 letters, digits, - or _)
chart-table-geometry = column-widths and row-heights give one finite, positive weight per column or row
chart-axis-interval = an axis interval must be a number above 0
chart-axis-bounds = an axis max must be above its min
chart-bar-gap = barCategoryGap goes on a bar series only: a percentage from 0% to under 100%, or a length in points of 0 or more
chart-ref-and-inline = an option cannot hold a data reference and inline data: keep one of them
chart-ref-null = `data` cannot be null: remove the key instead
chart-columns-invalid = `columns` needs `data` and lists 1 to 64 valid, distinct column ids
