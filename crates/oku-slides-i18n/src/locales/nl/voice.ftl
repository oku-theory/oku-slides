# Spoken commands: comma-separated forms, matched whole, never with placeables.

voice-yes = ja, jazeker, zeker, oké, ok, okay, prima, klopt, bevestig, bevestigen, akkoord
voice-no = nee, neen, annuleer, annuleren, weiger
voice-negation = niet, nooit, geen

voice-stop = stop, stoppen, genoeg, stil, hou op, stop met luisteren
voice-ordinal-1 = eerste, een
voice-ordinal-2 = tweede, twee
voice-ordinal-3 = derde, drie
voice-ordinal-4 = vierde, vier
voice-ordinal-5 = vijfde, vijf
voice-ordinal-6 = zesde, zes
voice-ordinal-7 = zevende, zeven
voice-ordinal-8 = achtste, acht
voice-ordinal-9 = negende, negen

voice-next = volgende, volgende dia, verder, vooruit
voice-previous = vorige, vorige dia, terug, ga terug
voice-first = eerste dia, begin, naar het begin, aan het begin, terug naar het begin
voice-last = laatste dia, laatste, einde, naar het einde, aan het einde
voice-exit = verlaat, verlaten, presentatie verlaten, verlaat de presentatie, escape, esc

voice-wake = oku, hé oku, hoi oku, hey oku, ok oku
voice-filler = alsjeblieft, alstublieft, graag, dank je, bedankt, eh, euh, nou, nu, de, het
voice-option = optie, nummer, keuze

voice-verb-replace = vervangen, vervang, overschrijven, overschrijf
voice-verb-merge = samenvoegen, voeg samen, mergen, combineren, combineer
voice-verb-discard = weggooien, gooi weg, verwerpen, verwerp
voice-verb-delete = verwijderen, verwijder, wissen, wis
voice-verb-use-api = API gebruiken, gebruik API, gebruik de API, de API gebruiken
voice-verb-install = installeren, installeer, bijwerken, werk bij
voice-verb-quit = afsluiten, sluit af, app afsluiten, programma afsluiten
voice-verb-close = sluiten, sluit
voice-verb-import = importeren, importeer

voice-say-question = { $question }
voice-say-option = Optie { $n }: { $option }.
voice-say-confirm = Zeg ter bevestiging „{ $verb }”, of zeg nee.
voice-say-confirm-yes = Zeg ter bevestiging ja, of zeg nee.
voice-say-permission = De agent vraagt om toestemming: zeg ja om één keer toe te staan, of nee.
voice-say-agent-refused = De agent heeft het verzoek geweigerd.
voice-say-agent-stopped = De agent is gestopt.
voice-say-agent-no-start = De agent kon niet starten.
voice-say-agent-no-tools = De tools van dit tabblad zijn niet beschikbaar.
