chart-invalid-option = خيارات غير صالحة: { $reason }
chart-patch-dataset = لا يمكن لتصحيح الخيارات تغيير `dataset`: استخدم set_chart_data
chart-patch-object = يجب أن يكون التصحيح كائن JSON
chart-render = تعذّر رسم المخطط
chart-data-no-row = الصف { $row } غير موجود
chart-data-no-column = العمود { $col } غير موجود ({ $width } أعمدة)
chart-data-insert-row = لا يمكن إدراج صف عند { $at }
chart-data-remove-row = لا يمكن حذف الصف { $at }
chart-data-insert-column = لا يمكن إدراج عمود عند { $at }
chart-data-too-many-cells = عدد الخلايا أكبر من عدد الصفوف
chart-data-remove-column = لا يمكن حذف العمود { $at }
chart-data-keep-header = يجب أن يحتفظ الجدول بصف العناوين
chart-no-series = مطلوب سلسلة واحدة على الأقل
chart-dataset-header = يجب أن يحتوي dataset.source على صف العناوين على الأقل
chart-unknown-column = العمود «{ $name }» غير موجود في dataset (الأعمدة: { $columns })
chart-column-out-of-range = العمود { $index } خارج dataset ({ $count } أعمدة)
chart-no-default-column = لا يوجد عمود { $index } في dataset: حدّد `encode`
chart-category-data = دون dataset، يحتاج محور الفئات إلى `data`
chart-mixed-series = لا يمكن دمج سلسلة من نوع { $kind } مع أعمدة أو خطوط
chart-horizontal-lines = الخطوط غير مدعومة أفقيًا
chart-series-numbers = السلسلة { $index }: يجب أن تكون البيانات أرقامًا
chart-series-empty = السلسلة { $index } بلا بيانات
chart-single-series = يحتوي مخطط { $kind } على سلسلة واحدة بالضبط
chart-pie-item = pie: يجب أن يكون كل عنصر بيانات {"{"} name, value {"}"}
chart-pie-empty = مخطط دائري بلا بيانات
chart-scatter-mixed = لا يمكن دمج مخطط التشتت مع أنواع أخرى
chart-scatter-point = السلسلة { $index }: يجب أن تكون كل نقطة [x, y]
chart-radar-indicators = radar دون dataset: الحقل `radar.indicator` مطلوب
chart-radar-item = radar: يجب أن يكون كل عنصر بيانات {"{"} name, value: [..] {"}"}
chart-radar-empty = مخطط رادار بلا بيانات
chart-radar-values = radar: «{ $name }» يحتوي على { $values } قيم لـ { $axes } محاور
chart-default-series = السلسلة { $n }
chart-default-category = الفئة
chart-default-value = القيمة
chart-default-name = الاسم
chart-default-axis = المحور
chart-default-x = { $name } (x)
chart-patch-inline-data = مع وجود dataset، يجب أن تبقى البيانات فيه: عدّلها باستخدام set_chart_data
