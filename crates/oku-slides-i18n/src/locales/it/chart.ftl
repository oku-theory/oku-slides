chart-invalid-option = opzioni non valide: { $reason }
chart-patch-dataset = una patch di opzioni non può modificare `dataset`: usa set_data
chart-patch-object = la patch deve essere un oggetto JSON
chart-render = impossibile disegnare il grafico
chart-data-no-row = la riga { $row } non esiste
chart-data-no-column = la colonna { $col } non esiste ({ $width } colonne)
chart-data-insert-row = impossibile inserire una riga in { $at }
chart-data-remove-row = impossibile rimuovere la riga { $at }
chart-data-insert-column = impossibile inserire una colonna in { $at }
chart-data-too-many-cells = più celle che righe
chart-data-remove-column = impossibile rimuovere la colonna { $at }
chart-data-keep-header = la tabella deve mantenere la riga di intestazione
chart-data-ids-length = dataset.ids richiede un id per riga e dataset.columns uno per colonna
chart-data-ids-duplicate = un id di riga o di colonna è ripetuto
chart-data-ids-invalid = un id di riga o di colonna ha da 1 a 64 lettere, cifre, - o _
chart-data-id-taken = questo id di riga o di colonna è già in uso
chart-no-series = serve almeno una serie
chart-dataset-header = dataset.source deve contenere almeno la riga di intestazione
chart-unknown-column = la colonna «{ $name }» non è nel dataset (colonne: { $columns })
chart-column-out-of-range = la colonna { $index } è fuori dal dataset ({ $count } colonne)
chart-no-default-column = nessuna colonna { $index } nel dataset: specifica `encode`
chart-category-data = senza dataset, l’asse delle categorie richiede `data`
chart-mixed-series = una serie { $kind } non può essere combinata con barre o linee
chart-horizontal-lines = le linee non sono supportate in orizzontale
chart-series-numbers = serie { $index }: i dati devono essere numeri
chart-series-empty = la serie { $index } non ha dati
chart-single-series = un grafico { $kind } ha esattamente una serie
chart-pie-item = pie: ogni elemento dei dati deve essere {"{"} name, value {"}"}
chart-pie-empty = grafico a torta senza dati
chart-scatter-mixed = un grafico a dispersione non può essere combinato con altri tipi
chart-scatter-point = serie { $index }: ogni punto deve essere [x, y]
chart-radar-indicators = radar senza dataset: `radar.indicator` è obbligatorio
chart-radar-item = radar: ogni elemento dei dati deve essere {"{"} name, value: [..] {"}"}
chart-radar-empty = radar senza dati
chart-radar-values = radar: «{ $name }» ha { $values } valori per { $axes } assi
chart-default-series = Serie { $n }
chart-default-category = Categoria
chart-default-value = Valore
chart-default-name = Nome
chart-default-axis = Asse
chart-default-total = Totale
chart-default-x = { $name } (x)
chart-patch-inline-data = con un dataset, i dati devono restare nel dataset: modificali con set_data
chart-bad-color = colore non valido: { $color } (atteso #rgb o #rrggbb)
chart-waterfall-dataset = un grafico a cascata legge i dati solo da dataset
chart-data-no-dataset = il grafico non ha una tabella di dati (dataset)
chart-table-empty = la tabella deve avere almeno una riga e una colonna
chart-table-ragged = tutte le righe della tabella devono avere lo stesso numero di celle
chart-table-too-large = una tabella ha al massimo { $rows } righe e { $columns } colonne
chart-table-cell-too-long = una cella della tabella contiene al massimo { $max } caratteri
chart-table-not-finite = i numeri della tabella devono essere finiti
chart-table-chart-option = chart deve essere un oggetto di opzioni del grafico
chart-table-chart-columns = chart-columns deve elencare identificatori di colonna validi e distinti (da 1 a 64 lettere, cifre, - o _)
