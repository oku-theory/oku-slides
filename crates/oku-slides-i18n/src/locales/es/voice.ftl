# Spoken commands: comma-separated forms, matched whole, never with placeables.

voice-yes = sí, claro, vale, de acuerdo, ok, okay, confirmo, confirmar, correcto, afirmativo
voice-no = no, nope, cancelar, cancela, rechazar, rechaza
voice-negation = nunca, jamás, tampoco, ni

voice-stop = para, detente, basta, silencio, deja de escuchar, para de escuchar
voice-ordinal-1 = primero, primera, uno, una
voice-ordinal-2 = segundo, segunda, dos
voice-ordinal-3 = tercero, tercera, tres
voice-ordinal-4 = cuarto, cuarta, cuatro
voice-ordinal-5 = quinto, quinta, cinco
voice-ordinal-6 = sexto, sexta, seis
voice-ordinal-7 = séptimo, séptima, siete
voice-ordinal-8 = octavo, octava, ocho
voice-ordinal-9 = noveno, novena, nueve

voice-next = siguiente, siguiente diapositiva, siguiente diapo, adelante, avanza, avanzar
voice-previous = anterior, diapositiva anterior, diapo anterior, atrás, retrocede, retroceder
voice-first = primera diapositiva, primera diapo, principio, al principio, inicio, al inicio
voice-last = última diapositiva, última diapo, último, última, final, al final
voice-exit = salir, sal, salir de la presentación, escape, esc

voice-wake = oku, hola oku, oye oku, ok oku
voice-filler = por favor, gracias, eh, em, ahora, pues, bueno, el, la, los, las
voice-option = opción, número, elemento

voice-verb-replace = reemplazar, reemplaza, sustituir, sustituye, sobrescribir, sobrescribe
voice-verb-merge = fusionar, fusiona, combinar, combina
voice-verb-discard = descartar, descarta, desechar, desecha
voice-verb-delete = eliminar, elimina, borrar, borra, suprimir, suprime
voice-verb-use-api = usar la API, usar API, usa la API, usa API, utilizar la API, utilizar API
voice-verb-install = instalar, instala, actualizar, actualiza
voice-verb-quit = cerrar la aplicación, cierra la aplicación, salir de la aplicación, salir de la app
voice-verb-close = cerrar, cierra, cerrad
voice-verb-import = importar, importa

voice-say-question = { $question }
voice-say-option = Opción { $n }: { $option }.
voice-say-confirm = Para confirmar, di «{ $verb }», o di no.
voice-say-confirm-yes = Para confirmar, di sí, o di no.
voice-say-confirm-action = Para { $action }, di sí, o di no.
voice-action-open = abrir el archivo
voice-action-save = guardar la presentación
voice-action-save-copy = guardar una copia
voice-action-move = mover la presentación
voice-action-new-deck = crear una presentación nueva
voice-action-copy-pack = copiar el paquete
voice-action-copy-theme = copiar el tema
voice-action-edit-theme = cambiar el tema
voice-action-change-setting = cambiar el ajuste
voice-action-change-dictation = cambiar el dictado
voice-action-download = descargar el modelo
voice-action-select-agent = cambiar de agente
voice-say-permission = El agente pide un permiso: di sí para permitirlo una vez, o no.
voice-say-agent-refused = El agente rechazó la solicitud.
voice-say-agent-stopped = El agente se detuvo.
voice-say-agent-no-start = El agente no pudo iniciarse.
voice-say-agent-no-tools = Las herramientas de esta pestaña no están disponibles.
