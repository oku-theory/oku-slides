      ],
      "mcp": [
        { "tool": "show_variants", "args": { "slide": "s-libre", "variants": [
          { "label": "Un", "ops": [{ "op": "set_param", "target": { "slide": "s-libre", "element": "e-texte" }, "param": "body", "value": [{ "runs": [{ "t": "Variante un" }] }] }] },
          { "label": "Deux", "ops": [{ "op": "set_param", "target": { "slide": "s-libre", "element": "e-texte" }, "param": "body", "value": [{ "runs": [{ "t": "Variante deux" }] }] }] }
        ] } },
        { "tool": "report", "args": { "title": "Deux variantes proposées", "facts": ["Un : texte court", "Deux : texte long"], "slide": "s-libre" } }
      ],
      "chunks": ["Voici deux variantes."]
    },
    {
      "tool_calls": [{ "id": "t4", "title": "Lire la slide" }],
      "mcp": [
        { "tool": "ask_choice", "args": { "question": "Laquelle ?", "options": [
          { "id": "a", "label": "A" }, { "id": "b", "label": "B" }
