{
  "params": {
    "title": "Référence",
    "subtitle": "Tous les widgets",
    "author": "Oku",
    "date": "2026-09-27",
    "organization": "Oku Theory"
  },
  "vars": {
    "client": "Acme"
  },
  "slides": [
    {
      "id": "s-titre",
      "kind": "title"
    },
    {
      "id": "s-sommaire",
      "kind": "toc"
    },
    {
      "id": "s-chap",
      "kind": "chapter",
      "params": {
        "title": "Chapitre {{client}}",
