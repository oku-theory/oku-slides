  {
   "id": "s-typst-kpi",
   "kind": "content",
   "params": {
    "kicker": "oku-slides",
    "title": "Déclarer un widget",
    "layout": "default",
    "blocks": [
     {
      "id": "b-typst-kpi",
      "kind": "text",
      "params": {
       "body": [
        {
         "runs": [
          {
           "t": "#import \"/oku-slides/lib.typ\": widget, field, fields-stack, params as p, color-of, size-of"
          }
         ]
        },
        {
         "runs": [
          {
           "t": "#import \"_commun.typ\": carte"
          }
         ]
        },
        {
         "runs": [
          {
           "t": " "
          }
         ]
        },
        {
         "runs": [
          {
           "t": "#let widget = widget(\"kpi\", label: \"KPI\","
          }
         ]
        },
        {
         "runs": [
          {
           "t": "  params: (value: p.plain(default: \"42 %\"), label: p.plain(),"
          }
         ]
        },
        {
         "runs": [
          {
           "t": "           trend: p.choice(\"up\", \"down\", \"flat\")),"
          }
         ]
        },
        {
         "runs": [
          {
           "t": "  (args, ctx) => carte(ctx.tokens, fields-stack(spacing: 8pt,"
          }
         ]
        },
        {
         "runs": [
          {
           "t": "    field(ctx, \"value\", { set text(size: size-of(ctx.tokens, \"display\")); args.value }),"
          }
         ]
        },
        {
         "runs": [
          {
           "t": "    field(ctx, \"label\", { set text(size: size-of(ctx.tokens, \"body\")); args.label }),"
          }
         ]
        },
        {
         "runs": [
          {
           "t": "  )))"
          }
         ]
        }
       ]
      },
      "style": {
       "font": "mono",
       "size": "caption",
       "leading": "tight"
      }
     },
